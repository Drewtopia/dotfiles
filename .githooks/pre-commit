#!/usr/bin/env bash
# Refuses a commit whose staged plain-text changes name the work organization, project, repo or
# tracker. This repo is public; work names belong in age-encrypted files (*.age), which pass.
# The names come from fnox (~/.config/fnox/work.toml), so this file holds none of them. On a
# machine without them, it says so and lets the commit through.
set -uo pipefail

get() { fnox get "$1" 2>/dev/null; }
org=$(get WORK_AZ_ORG) proj=$(get WORK_AZ_PROJECT) repo=$(get WORK_REPO) tracker=$(get WORK_TRACKER_REPO)
if [ -z "$org" ] || [ -z "$proj" ] || [ -z "$repo" ] || [ -z "$tracker" ]; then
  echo "pre-commit: no WORK_* names from fnox on this machine; work-name check skipped" >&2
  exit 0
fi

# Added lines only, in text files that are not age-encrypted.
added=$(git diff --cached -U0 --no-color -- . ':(exclude)*.age' | grep -E '^\+[^+]' || true)
[ -n "$added" ] || exit 0

# The short project name is matched as a whole word and case-sensitively, so ordinary words
# that contain it do not trip the check; the longer names are matched anywhere, any case.
hits=$( { grep -inE "$org|$repo|${tracker#*/}" <<<"$added"; grep -nwE "$proj" <<<"$added"; } | sort -u)
if [ -n "$hits" ]; then
  echo "pre-commit: refused — staged changes name work in a public repo:" >&2
  printf '%s\n' "$hits" | cut -c1-200 >&2
  echo "Read the name with fnox get WORK_* at run time, or move the file under chezmoi encryption (chezmoi add --encrypt)." >&2
  exit 1
fi
