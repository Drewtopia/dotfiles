# wezterm runs on the Windows host and reaches into WSL; native Linux may still use it.
{{ if .is_wsl }}
.wezterm.lua
{{ end }}

# Headless Azure DevOps credential fallback; only work WSL2 needs it, the rest use GCM.
{{ if not (and .work .is_wsl) }}
.git-azdo-helper.sh
{{ end }}

