# Claude
{{- if and (eq .chezmoi.os "windows") .work }}
# Claude Code is not used on the work Windows host.
.claude
.claude/**
{{- else }}
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/hooks/
!.claude/skills/
{{-   if eq .chezmoi.os "windows" }}
# settings.json stays ignored: a Windows modify_ .json needs [interpreters.json],
# which retargets it to `.claude/settings`; run_onchange_after_57 merges instead.
# Community skills are NTFS junctions chezmoi cannot read, so list only ours.
.claude/skills/*
{{-     range glob (joinPath .chezmoi.sourceDir "dot_claude/skills/*") }}
!.claude/skills/{{ base . }}
{{-     end }}
# Symlink; requires Developer Mode.
!.claude/rules
{{-   else }}
!.claude/settings.json
!.claude/memory
!.claude/rules
{{-   end }}
!.claude/CLAUDE.md
{{- end }}

{{ if .relocated -}}
# Junction to tools_root; chezmoi can't manage junctions.
.local/bin
{{- end }}
