{{- /* Debian/Ubuntu default .profile plus mise shims and the deno env loader. */ -}}
if [ -n "$BASH_VERSION" ]; then
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

if [ -d "$HOME/bin" ]; then
    PATH="$HOME/bin:$PATH"
fi

if [ -d "$HOME/.local/bin" ]; then
    PATH="$HOME/.local/bin:$PATH"
fi

# zsh never reads this file; bash and sh login shells get mise tools from the shims.
{{- if .dev_computer }}
if command -v mise >/dev/null 2>&1; then
    export MISE_DATA_DIR="{{ .directories.mise_dir }}"
    eval "$(mise activate bash --shims)"
fi
{{- end }}
[ -f "${HOME}/.deno/env" ] && . "${HOME}/.deno/env"
