HashKnownHosts no

# Untracked, machine-local overrides (per-machine usernames, one-off hosts).
# ssh silently ignores it when absent and merges its Host blocks with those below.
Include config.override

Host *
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
{{- if eq .chezmoi.os "darwin" }}
  AddKeysToAgent yes
  UseKeychain yes
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}


Host github.com
  User git
  # Port 22 blocked by corporate firewall; also needed on Windows because
  # work-WSL git routes SSH through ssh.exe, which reads the Windows config.
  Hostname ssh.github.com
  Port 443

{{- if .personal }}

# Home lab. Names resolve via AdGuard (.home) — no IPs in git. Per-machine
# usernames that shouldn't be published live in the untracked config.override.
Host drew-pd
  HostName drew-pd.home

Host drew-mbp
  HostName drew-mbp.home
  User drew

Host homeassistant
  HostName homeassistant.local
  User root

{{- if eq .chezmoi.os "darwin" }}

# Work laptop, reachable from the mac on the home LAN. It's one machine with two
# NICs — dock (work-eth.home) and wifi (work-wifi.home) — so `work` and work-wsl
# probe eth first and fall back to wifi. HostKeyAlias pins one key so roaming
# between NICs doesn't trip known_hosts. `User` lives in config.override so the
# work login stays out of a public repo.
Host work
  HostKeyAlias work
  RemoteCommand pwsh
  RequestTTY yes
  ProxyCommand sh -c 'for h in work-eth.home work-wifi.home; do nc -z -G1 "$h" %p 2>/dev/null && exec nc "$h" %p; done; echo "work: neither eth nor wifi up on %p" >&2; exit 1'

Host work-wsl
  Port 2222
  HostKeyAlias work-wsl
  ProxyCommand sh -c 'for h in work-eth.home work-wifi.home; do nc -z -G1 "$h" %p 2>/dev/null && exec nc "$h" %p; done; echo "work-wsl: neither eth nor wifi up on %p" >&2; exit 1'
{{- end }}
{{- end }}

{{ if .work -}}
# Azure DevOps doesn't support ed25519 yet
Host ssh.dev.azure.com
  IdentityFile ~/.ssh/id_rsa

{{- if .is_wsl }}
# Short alias for work WSL2 machine
Host work-wsl
  HostName {{ .hostname }}
  User {{ .chezmoi.username }}
{{- end }}
{{ end -}}
