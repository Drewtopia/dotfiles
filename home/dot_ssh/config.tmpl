HashKnownHosts no

# Untracked machine-local overrides; ssh ignores it when absent.
Include config.override

Host *
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
{{- if eq .chezmoi.os "darwin" }}
  AddKeysToAgent yes
  UseKeychain yes
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}


Host github.com
  User git
  # Port 22 is blocked by the corporate firewall.
  Hostname ssh.github.com
  Port 443

{{- if .personal }}

# Names resolve via AdGuard (.home); unpublished usernames live in config.override.
Host drew-pd
  HostName drew-pd.home

Host drew-mbp
  HostName drew-mbp.home
  User drew

Host homeassistant
  HostName homeassistant.local
  User root

{{- if eq .chezmoi.os "darwin" }}

# One work laptop with two NICs: probe dock eth, then wifi. HostKeyAlias pins one
# key across NICs; `User` lives in config.override to keep it out of this repo.
Host work
  HostKeyAlias work
  RemoteCommand pwsh
  RequestTTY yes
  ProxyCommand sh -c 'for h in work-eth.home work-wifi.home; do nc -z -G1 "$h" %p 2>/dev/null && exec nc "$h" %p; done; echo "work: neither eth nor wifi up on %p" >&2; exit 1'

Host work-wsl
  Port 2222
  HostKeyAlias work-wsl
  ProxyCommand sh -c 'for h in work-eth.home work-wifi.home; do nc -z -G1 "$h" %p 2>/dev/null && exec nc "$h" %p; done; echo "work-wsl: neither eth nor wifi up on %p" >&2; exit 1'
{{- end }}
{{- end }}

{{ if .work -}}
# Azure DevOps doesn't support ed25519 yet
Host ssh.dev.azure.com
  IdentityFile ~/.ssh/id_rsa

{{- if .is_wsl }}
Host work-wsl
  HostName {{ .hostname }}
  User {{ .chezmoi.username }}
{{- end }}
{{ end -}}
