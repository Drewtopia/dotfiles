{{- if eq .chezmoi.os "windows" -}}
[wsl2]
{{- if .work }}
# Capped so a parallel test run can't CPU-starve the host (hangs ssh and
# `wsl --shutdown`); the larger swap keeps WSL from thrashing the vhdx.
memory=16GB
processors=12
swap=8GB
{{- end }}
gpuSupport=false
dnsProxy=false
autoProxy=false
localhostForwarding={{ if .work }}true{{ else }}false{{ end }}

[experimental]
{{- if .work }}
autoMemoryReclaim=gradual
sparseVhd=true
{{- end }}
bestEffortDnsParsing=true
{{- end }}
