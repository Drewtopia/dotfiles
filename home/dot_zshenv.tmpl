export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

typeset -U path fpath manpath
typeset +x FPATH

# Remove-then-prepend: /etc/zprofile's path_helper pushes system paths ahead, and
# .zprofile re-sources this file to put ours back in front.
path=("$HOME/.local/bin" ${path:#$HOME/.local/bin})

{{- if eq .chezmoi.os "darwin" }}
path=("/opt/homebrew/bin" ${path:#/opt/homebrew/bin})
{{- end }}

# Shims for non-interactive shells (topgrade, cron, `zsh -c`) that never source
# .zshrc; interactive shells also run `mise activate`.
{{- if .dev_computer }}
path=("{{ .directories.mise_dir }}/shims" ${path:#{{ .directories.mise_dir }}/shims})
{{- end }}

alias wget="wget --hsts-file='${XDG_DATA_HOME}/wget-hsts'"
export ANDROID_HOME="$XDG_DATA_HOME/android"
export ANSIBLE_HOME="${XDG_DATA_HOME}/ansible"
export CARGO_HOME="${XDG_DATA_HOME}/cargo"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export DOTNET_CLI_HOME="${XDG_DATA_HOME}/dotnet"
export GNUPGHOME="${XDG_DATA_HOME}/gnupg"
export IPYTHONDIR="$XDG_CONFIG_HOME/ipython"
export JUPYTER_CONFIG_DIR="$XDG_CONFIG_HOME/jupyter"
export LESSHISTFILE="${XDG_STATE_HOME}/less/history"
export NPM_CONFIG_USERCONFIG="${XDG_CONFIG_HOME}/npm/npmrc"
export PYTHONSTARTUP="${XDG_CONFIG_HOME}/python/pythonrc"
export PYTHON_HISTORY="${XDG_STATE_HOME}/python_history"
export RUSTUP_HOME="${XDG_DATA_HOME}/rustup"
export ZDOTDIR="${XDG_CONFIG_HOME}/zsh"

# Here, not .zshrc, so non-interactive shells see the same values.
for _editor in nvim vim vi; do
    if command -v "$_editor" >/dev/null 2>&1; then
        export EDITOR="$_editor"
        break
    fi
done
unset _editor
export PAGER=less
export LESS=FRX
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export RIPGREP_CONFIG_PATH=$XDG_CONFIG_HOME/ripgrep/config

{{- if eq .chezmoi.os "darwin" }}
# Skipped over SSH, where biometric unlock is unavailable.
if [[ -z "$SSH_CONNECTION" ]]; then
    export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

# Tools mise owns.
export HOMEBREW_FORBIDDEN_FORMULAE="bat git-delta eza fd gdu gh glow golangci-lint jless jq lazygit ripgrep yt-dlp age atuin carapace fzf zoxide gitleaks topgrade tokei yq navi neovim python go pipx lsd powerlevel10k direnv"

# superwhisper CLI reads settings from ~/superwhisper, not its ~/Documents default
export SUPERWHISPER_SETTINGS="$HOME/superwhisper/settings/settings.json"
{{- end }}

[[ -f "${HOME}/.zshenv.local" ]] && source "${HOME}/.zshenv.local"
