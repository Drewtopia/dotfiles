{
  "version": 4,
  "lines": [
    [
      {
        "id": "worktrunk-statusline",
        "type": "custom-command",
        "commandPath": "wt list statusline --format=claude-code | R=$(basename \"$(git remote get-url origin 2>/dev/null)\") perl -pe 's{\\e\\]8;;(\\S*?)\\e\\\\.*?\\e\\]8;;\\e\\\\}{index($1,\"/_git/\")<0 || index($1,\"/_git/$ENV{R}/\")>=0 ? $& : \"\"}ge'",
        "timeout": 5000,
        "preserveColors": true
      }
    ],
    [
      {
        "id": "eod-statusline",
        "type": "custom-command",
        "commandPath": "command -v eod-statusline >/dev/null && exec eod-statusline",
        "timeout": 2000,
        "preserveColors": true
      }
    ]
  ],
  "flexMode": "full-minus-40",
  "compactThreshold": 60,
  "colorLevel": 2,
  "inheritSeparatorColors": false,
  "globalBold": false,
  "minimalistMode": false,
  "powerline": {
    "enabled": false,
    "separators": [
      ""
    ],
    "separatorInvertBackground": [
      false
    ],
    "startCaps": [],
    "endCaps": [],
    "autoAlign": false,
    "continueThemeAcrossLines": false
  }
}
