{{- /* WSL agents drive Windows through powershell.exe interop, so it gets the Windows packs too. */ -}}
{{- $windows := or (eq .chezmoi.os "windows") .is_wsl -}}
[general]
log_file = "~/.local/share/dcg/blocked.log"
# Default 1000. A long compound command (grep/sed/knip chains) can take longer to
# evaluate; dcg then asks, which stalls an unattended Orca worker at the prompt.
hook_timeout_ms = 3000

[packs]
enabled = [
  "platform.azure_devops",
  "platform.github",
  "cicd.github_actions",
  "cloud.azure",
  "remote.ssh",
  "remote.rsync",
  "system.services",
  "system.permissions",
  "containers.docker",
  "containers.compose",
  "secrets.onepassword",
  "package_managers",
  "careful_company_running_windows.guardrails",
{{- if $windows }}
  "windows.misc",
  "windows.system",
  "windows.powershell",
{{- end }}
]
custom_paths = ["~/.config/dcg/packs/*.yaml"]

[policy.packs]
"drew.azure_writes" = "ask"
"drew.homelab" = "ask"
"drew.git_policy" = "deny"

# An ask is a deny wherever no prompt reaches a person (an SDK-hosted session in auto
# mode), so each rule here is sorted: warn for a shape that loses nothing, ask for the rest.
# NOTE: these rules cannot see what a variable expands to, so they fire on every
# `> $VAR/file` write or `mv "$A" "$B"` in a scratch dir. They warn: writes to dotfiles,
# .git internals and ~/.config, and moves of home or system paths, are still denied by
# their own rules.
# branch-dynamic-token stays ask because warn would let `git branch -D $B` run.
[policy.rules]
"core.filesystem:redirect-truncate-dynamic-path" = "warn"
"core.filesystem:mv-dynamic-path" = "warn"
"core.git:branch-dynamic-token" = "ask"
# Agents queue test runs. Every other Azure write in the pack still asks.
"drew.azure_writes:pipelines-run" = "warn"
# The rules that lose data stay deny; the rest of drew.homelab asks. Unattended
# sessions get no ask at all: hooks/dcg-unattended-ask.js turns it into a deny.
"drew.homelab:proxmox-guest-destroy" = "deny"
"drew.homelab:zfs-destroy" = "deny"
"drew.homelab:zpool-destroy" = "deny"
# NOTE: these also match the bare words in grep patterns, heredoc prose and `jq … settings.json` reads.
"system.services:reboot" = "ask"
"system.services:shutdown" = "ask"
"careful_company_running_windows.guardrails:agent-hook-config-tamper" = "ask"
# NOTE: powershell.exe and `ssh host 'pwsh -Command …'` strings holding `$` expressions are
# unparseable to dcg and denied outright.
"heredoc.shell:launcher-unverified" = "warn"
# Heredoc and inline-script bodies dcg cannot statically verify: an ordinary script
# holding `$(…)`, `zsh -c "$L"` or `< <(…)` is not a data-loss command, so it runs.
"heredoc.posix:substitution-unverified" = "warn"
"heredoc.posix:inline-launcher-unverified" = "warn"
"heredoc.posix:process-substitution" = "warn"
"heredoc.powershell:substitution-unverified" = "warn"
{{- if $windows }}
"windows.powershell:force-stop-or-restart-computer" = "ask"
{{- else }}
# No Windows commands run here, yet this pass denies long heredocs it gives up on.
"windows.filesystem:windows-filesystem-semantic-unverified" = "log"
{{- end }}

# Agent-owned scratch: the session job dir and Claude Code's temp dir
# (/tmp/claude-<uid>/<project>/<session>/scratchpad; /private/tmp on macOS).
# Only literal targets are exempt, and only from this one rule: a write to
# ~/.bashrc or a chained `git reset --hard` is still judged by its own rule.
[rules."core.filesystem:redirect-truncate-root-home"]
exempt_target_globs = ["~/.claude/jobs/*/tmp/**", "/tmp/claude-*/**", "/private/tmp/claude-*/**"]

[history]
enabled = true
