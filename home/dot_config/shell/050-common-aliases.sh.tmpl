alias cd..='cd ../'
alias ..='cd ../'
alias ...='cd ../../'
alias .3='cd ../../../'
alias .4='cd ../../../../'
alias .5='cd ../../../../../'
alias .6='cd ../../../../../../'
alias ~="cd ~"
alias ax='chmod a+x'                   # system: make file executable
alias path='echo -e ${PATH//:/\\n}'    # system: Echo all executable Paths
alias fpath='echo -e ${FPATH//:/\\n}'  # system: Echo fpath
alias untar='tar -zxvf'                # Extract tar.gz file
alias mktar='tar -cvzf'                # Create a tar.gz file
alias numfiles='echo $(ls -1 | wc -l)' # Count of non-hidden files in current dir
alias listpaths='echo $PATH | tr ":" "\n" | uniq -c | sort -nr'

####################### WORKTRUNK #######################
{{- if lookPath "wt" }}
# Every worktree gets a tmux session with claude already running in it — created
# by the pre-start hook in ~/.config/worktrunk/config.toml. These four differ only
# in whether they hand your terminal over to that session.
#
# wts/wtc leave you where you are; the session runs detached, attach later with
# `ta <branch>`. wtts/wttc drop you straight into it.
#
# wtc no longer passes --execute=claude: the hook starts claude in the session, so
# doing both would give you two.

# Switch to an existing worktree (cd only), e.g. wts feat
alias wts='wt switch'
# New worktree; its session + claude start detached
alias wtc='wt switch --create'

# The wtt* pair must be functions, not aliases: `wt switch` takes
# [OPTIONS] [BRANCH] [-- EXECUTE_ARGS], and an alias appends the branch at the
# end — after `--`, where it would be passed to tmux instead of wt. A function
# puts "$@" in the right slot. -x execs, handing over the terminal.
# `wtts` needs its own attach because pre-start only fires on create.

# Switch to a worktree and attach to its session, e.g. wtts feat
wtts() { wt switch          -x tmux "$@" -- attach -t '{{ "{{ branch | sanitize }}" }}'; }
# New worktree and attach straight into its session
wttc() { wt switch --create -x tmux "$@" -- attach -t '{{ "{{ branch | sanitize }}" }}'; }
# Remove the current worktree + delete its branch
alias wtr='wt remove'
# List worktrees with status
alias wtl='wt list'
# Tail a worktrunk hook's log, e.g. wtlog user:post-start:server
wtlog() { tail -f "$(wt config state logs get --hook="$1")"; }
{{- end }}

####################### TOOL ALIASES #######################
{{- if lookPath "bat" }}
alias cat=bat
{{- else if lookPath "batcat" }}
alias cat=batcat
{{- end }}

####################### LIST DIRECTORY CONTENTS #######################
{{- if lookPath "eza" }}
# List filenames on one line
alias ls='eza --git --icons=auto'

# List filenames with long format
alias l='eza -l --classify=auto --icon=autos {{- if not (and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64")) }} --git{{ end }}'

# List all files
alias ll='eza -lah --classify=auto --icons=auto {{- if not (and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64")) }} --git{{ end }}'

# List files by last modified
alias llm='ll --sort=modified'

# List files with attributes
alias la='eza -lbhHigUmuSa --icons=auto {{- if not (and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64")) }} --git{{ end }}'

# List files with extended attributes
alias lx='eza -lbhHigUmuSa@ --icons=auto {{- if not (and (eq .chezmoi.os "linux") (eq .chezmoi.arch "arm64")) }} --git{{ end }}'

# List files in a tree view
alias lt='eza --tree --level=2 --icons=auto'

# List files in a tree view with long format
alias llt='eza -lah --classify=always --tree --level=2 --icons=auto'

# List files modified today
alias ltt='eza -lah --classify=always --icons=auto | grep "$(date +"%d %b")"'
{{- else if eq .chezmoi.os "darwin" }}
alias ls="ls -G"
alias ll='ls -FGlAhpv'
alias ltt='ls -FlAhpv| grep "$(date +"%d %b")"' # List files modified this day
{{- else }}
alias ls="ls --color=auto"
alias ll='ls -FlAhpv --color=auto'
alias ltt='ls -FlAhpv| grep "$(date +"%d %b")"' # List files modified today
{{- end }}
