# Rendered from 1Password at apply time, so shell startup needs no op session.
# Items share names and a `token` field across vaults; .opVault picks the vault.
{{/* First apply without op renders nothing; once rendered, a missing op fails
     the apply rather than blanking working secrets. */ -}}
{{ $hasOp := lookPath "op" -}}
{{ if and (not .ephemeral) (not $hasOp) (stat (joinPath .chezmoi.homeDir ".config" "shell" "015-vault.sh")) -}}
{{ fail "015-vault.sh: op not found on PATH; refusing to overwrite rendered secrets" }}
{{- end -}}
{{ if and (not .ephemeral) $hasOp -}}
{{/* chezmoi's GitHub functions need it past 60 requests/hour. gh ranks
     GITHUB_TOKEN above its keyring, so `gh auth login` stays shadowed. */}}
export GITHUB_TOKEN={{ onepasswordRead (printf "op://%s/GitHub PAT/token" .opVault) | trim }}
export MISE_GITHUB_TOKEN="$GITHUB_TOKEN"
export GEMINI_API_KEY={{ onepasswordRead (printf "op://%s/Gemini API Key/token" .opVault) | trim }}
{{- /* The context7 plugin passes no key argument and regenerates its .mcp.json
     on update, so the env var is the only lever. */}}
export CONTEXT7_API_KEY={{ onepasswordRead (printf "op://%s/Context7 API Key/token" .opVault) | trim }}
{{ end -}}
