{{ if .dev_computer -}}
# mise - Modern runtime version manager
# Handles: node, pnpm, deno, bun, uv, python, go, etc.

# Consolidate mise directories under ~/.mise (see mise.jdx.dev/how-i-use-mise)
export MISE_DATA_DIR="{{ .directories.mise_dir }}"

if command -v mise >/dev/null 2>&1; then
    # Activate mise - this handles PATH and completions for all tools
    eval "$(mise activate zsh)"

    # Enable mise completions
    if [[ -n ${ZSH_NAME} ]]; then
        eval "$(mise completion zsh)"
    elif [[ -n ${BASH} ]]; then
        eval "$(mise completion bash)"
    fi
fi

# pnpm itself comes from mise; pnpm 11 puts global package binaries in $PNPM_HOME/bin.
if command -v pnpm >/dev/null 2>&1; then
    export PNPM_HOME="$HOME/.local/share/pnpm"
    case ":$PATH:" in
        *":$PNPM_HOME/bin:"*) ;;
        *) export PATH="$PNPM_HOME/bin:$PATH" ;;
    esac
fi
{{- end }}
