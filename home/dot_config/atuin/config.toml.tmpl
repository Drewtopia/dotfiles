db_path = "{{ .directories.xdg_data_dir }}/atuin/history.db"

dialect = "us"
timezone = "local"
update_check = true

workspaces = true
filter_mode_shell_up_key_binding = "directory"

ctrl_n_shortcuts = false

## Unanchored regexes: without ^ or $ they match anywhere in the command.
history_filter = [
  "^secret-cmd",
  "^innocuous-cmd .*--secret=.+",
  "^~$"
]

enter_accept = true
# daemon-fuzzy requires the daemon, which is disabled below.
search_mode = "fuzzy"

[stats]
common_prefix = ["sudo"]

[keys]

[sync]
records = true

[preview]

[daemon]
# Off: the shell hook calls the daemon with no timeout, so a wedged daemon freezes
# every command until Ctrl+C (atuinsh/atuin#3382).
enabled = false
autostart = false

[search]

[ai]
enabled = true
