# Personal policy on every machine. lefthook-personal passes it with --config on commit and
# push, beside whatever team policy a repo's own hooks check.

[commit]
# Subject length is the repo's rule; 0 turns each of commit-check's length checks off.
subject_max_length = 0
subject_min_length = 0
# message_pattern replaces commit-check's conventional-commit check, so this policy checks
# only what is banned; commit types stay with the repo's team policy and commitlint.
# Everywhere: the redact Claude Code mod's placeholder text ([LABEL-xxxxxxxx], eight hex
# digits), which has replaced real trailers before.
{{- if .work }}
# With .work set, a commit carries no AI trailer. Without it, attribution is allowed.
ai_attribution = "forbid"
# With .work set, the pattern also rejects the vendor words.
# A path (`.claude/`, `CLAUDE.md`) is not a mention.
message_pattern = '''^(?![\s\S]*\[[A-Z][A-Z0-9-]*-[0-9a-f]{8}\])(?!(?i:[\s\S]*(?:(?<!\.)claude(?!\.md)|\.claude(?!/)|anthropic)))'''
{{- else }}
message_pattern = '''^(?![\s\S]*\[[A-Z][A-Z0-9-]*-[0-9a-f]{8}\])'''
{{- end }}
{{- if and .work .email }}
# With .work and .email set, the author must use .email's domain, so a clone made outside
# the usual path cannot commit under another identity.
author_email_pattern = '^.+@{{ .email | splitList "@" | last | replace "." "\\." }}$'
{{- end }}

[branch]
# commit-check's default branch types already cover the Conventional Commit types and the
# agent prefixes (ai, claude, codex, copilot, cursor, agents). Setting allow_branch_types
# would replace that list, so the extras are whole-name patterns here instead: `agent/` for
# the AFK orchestrator's agent/issue-<n>-* branches, plus wip, revert and staging.
# main, master, develop and HEAD are always allowed.
allow_branch_names = ["agent/.+", "wip/.+", "revert/.+", "staging"]
