# Personal identity is the global default on every machine, work box included, so
# the work identity never lands on public repos. Static data, not the vault; work
# identity applies only to Azure DevOps repos via azure-signing.inc.
[user]
	name = {{ .identity.name }}
	email = {{ .identity.email }}
[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false
[alias]
	a = add
	ap = add -p
	amc = am --continue
	b = branch
	bm = branch --merged
	bnm = branch --no-merged
	c = clone
	ca = commit --amend
	cane = commit --amend --no-edit
	cf = commit --fixup
	cm = commit --message
	co = checkout
	cob = checkout -b
	com = checkout main
	cp = cherry-pick
	csm = commit -S --message
	d = diff --patience
	dc = diff --cached
	dom = diff origin/main
	fo = fetch origin
	fu = "!git log -n 16 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"
	g = grep --line-number
	mbhom = merge-base HEAD origin/main
	mff = merge --ff-only
	ol = log --pretty=oneline
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	p = push
	pf = push --force-with-lease
	prb = pull --rebase
	r = restore
	ra = rebase --abort
	rc = rebase --continue
	ri = rebase --interactive
	rl = reflog
	riom = rebase --interactive origin/main
	rpo = remote prune origin
	s = status -sb
	sh = "!git log -n 16 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git show"
	ss = "commit --message 'chore: snapshot' --no-gpg-sign"
	su = submodule update
	wd = diff --patience --word-diff
[branch]
	sort = -committerdate
[color]
	ui = auto
[column]
	ui = auto
[core]
{{- if .dev_computer }}
	editor = nvim
{{- end }}
	whitespace = trailing-space,space-before-tab
	autocrlf = {{ if eq .chezmoi.os "windows" }}true{{ else }}input{{ end }}
{{- if lookPath "delta" }}
	pager = delta
{{- end }}
[diff]
	algorithm = histogram
	colorMoved = plain
	renamelimit = 8192
	renames = true
{{- if lookPath "delta" }}
	colorMoved = default
{{- end }}
[fetch]
	all = true
	fsckobjects = false
	prune = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{ if .personal -}}
[http]
	cookiefile = ~/.config/git/cookies
{{ end -}}
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
{{- if .dev_computer }}
	tool = nvimdiff
{{- end }}
[mergetool]
	keepBackup = false
	prompt = false
{{- if .dev_computer }}
[mergetool "nvimdiff"]
	layout = "LOCAL,BASE,REMOTE / MERGED"
{{- end }}
[pager]
	branch = false
	grep = false
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = current
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[receive]
	fsckobjects = true
{{ if eq .chezmoi.os "windows" -}}
[safe]
	directory = {{ .chezmoi.workingTree }}
{{ end -}}
[status]
	submoduleSummary = true
[tag]
	sort = version:refname
[transfer]
	fsckobjects = true
[trim]
	bases = main,gh-pages

{{- /* Not personal WSL: azure is work-only there. */ -}}
{{- $azure := or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "windows") (not .is_wsl)) (and .work .is_wsl) }}
{{ if $azure -}}
# useHttpPath scopes tokens per-org. On macOS the general helper is osxkeychain,
# so `manager` is scoped to azure here; Windows/WSL inherit a global GCM helper.
[credential "https://dev.azure.com"]
	useHttpPath = true
	azreposCredentialType = oauth
{{- if eq .chezmoi.os "darwin" }}
	helper =
	helper = manager
{{- end }}
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}
# The Command Line Tools system gitconfig already sets osxkeychain; the empty
# reset stops git calling it twice per request.
[credential]
	helper =
	helper = osxkeychain
{{- end }}
{{- if .personal }}
[url "git@github.com:Drewtopia/"]
	insteadOf = https://github.com/Drewtopia/
[gpg]
	format = ssh
[gpg "ssh"]
	# Windows backslashes parse as escapes in a config value and break every git command.
	allowedSignersFile = "{{ joinPath .chezmoi.homeDir ".config" "git" "allowed_signers" | replace .chezmoi.pathSeparator "/" }}"
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[commit]
	gpgsign = true
{{- end }}

{{- if and .work .is_wsl }}
# NOTE: SSH transport stays on native Linux ssh; Windows ssh.exe fails every push
# whenever WSL interop drops.
[credential]
	helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe
# Headless fallback when GCM cannot show its sign-in dialog: mints an AAD token
# from the cached `az` session. After GCM so GCM stays primary; no `helper =`
# reset, which would wipe GCM from the Azure chain.
[credential "https://dev.azure.com"]
	helper = {{ .chezmoi.homeDir }}/.git-azdo-helper.sh
[includeIf "hasconfig:remote.*.url:https://dev.azure.com/**"]
	path = ~/.config/git/azure-signing.inc
[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:**"]
	path = ~/.config/git/azure-signing.inc
{{- end }}

{{- if and (eq .chezmoi.os "windows") (not .is_wsl) }}
# Git-for-Windows sets `helper = manager` in system config; the empty reset stops
# a double GCM call per request.
[credential]
	helper =
	helper = manager
{{- end }}

{{- $ghPath := lookPath "gh" }}
{{- if not $ghPath }}
{{-   $shimPath := joinPath .directories.mise_dir "shims" "gh" }}
{{-   if stat $shimPath }}
{{-     $ghPath = $shimPath }}
{{-   end }}
{{- end }}
{{- if $ghPath }}
{{- $ghPath = $ghPath | replace "\\" "/" }}
# NOTE: must stay below every global [credential] helper. The empty helper only
# clears helpers read before it; placed earlier, GitHub logins still reach GCM or
# osxkeychain, and on WSL the GCM store call hangs whenever interop is down.
[credential "https://github.com"]
	helper =
	helper = !"{{ $ghPath }}" auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !"{{ $ghPath }}" auth git-credential
{{- end }}

{{- if lookPath "delta" }}
[delta]
	navigate = true
	syntax-theme = Monokai Extended
	line-numbers = true
	side-by-side = true
	# Wrapped side-by-side lines panic delta (dandavison/delta#1839, #1726).
	wrap-max-lines = 0
	file-style = bold yellow ul
	file-decoration-style = none
	hunk-header-decoration-style = blue box
	hunk-header-file-style = red
	hunk-header-line-number-style = "#067a00"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = cyan
	line-numbers-right-style = cyan
	line-numbers-minus-style = 124
	line-numbers-plus-style = 28
	minus-style = syntax "#450a15"
	minus-emph-style = syntax "#600818"
	plus-style = syntax "#0e2f0e"
	plus-emph-style = syntax "#174517"
	whitespace-error-style = 22 reverse
	line-numbers-zero-style = "#444444"

[interactive]
	diffFilter = delta --color-only
{{- end }}

# Machine- or work-specific entries stay out of this public repo.
[include]
	path = ~/.config/git/config.local

{{/* vim: set filetype=gitconfig: */}}
