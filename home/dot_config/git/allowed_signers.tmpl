{{- $personalKey := joinPath .chezmoi.homeDir ".ssh" "id_ed25519.pub" -}}
# Local verification only; forges check the keys registered on the account.
# Addresses and keys are read at apply time, so neither lands here.
{{ if and (lookPath "op") .opVault -}}
{{-   $signingKey := onepasswordRead (printf "op://%s/Git Signing Key/public key" .opVault) | trim -}}
{{ .identity.email }} {{ $signingKey }}
{{ if .work }}{{ .email }} {{ $signingKey }}
{{ end -}}
{{ end -}}
{{- /* Older keys, so commits signed before the key-file switch still verify. */ -}}
{{ if and .work .is_wsl }}{{ .email }} ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMhN9/EmrCcRRlwlG+vR5dBRHNPDGSmqy1+TZMoBp6am
{{ end }}{{ if stat $personalKey }}{{ $parts := include $personalKey | trim | splitList " " }}{{ .identity.email }} {{ index $parts 0 }} {{ index $parts 1 }}
{{ end -}}
