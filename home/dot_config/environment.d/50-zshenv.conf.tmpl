# Services started by systemd --user (the T3 Code server, and every agent and hook it launches)
# never read ~/.zshenv, so the exports their tools depend on are repeated here. Keep in step
# with dot_zshenv.tmpl. Without WORKTRUNK_SYSTEM_CONFIG_PATH, a worktree an agent creates skips
# the work repo's worktrunk hooks (copy, trust, install, build).
XDG_DATA_HOME=${XDG_DATA_HOME:-${HOME}/.local/share}
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-${HOME}/.config}
XDG_STATE_HOME=${XDG_STATE_HOME:-${HOME}/.local/state}
XDG_CACHE_HOME=${XDG_CACHE_HOME:-${HOME}/.cache}
{{- if .work }}
WORKTRUNK_SYSTEM_CONFIG_PATH=${XDG_CONFIG_HOME}/worktrunk/work.toml
{{- end }}
