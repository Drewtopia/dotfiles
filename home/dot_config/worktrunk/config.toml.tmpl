# chezmoi:template:left-delimiter="<%" right-delimiter="%>"
# Angle-percent delimiters: worktrunk's double braces and TOML's double brackets collide with the defaults.
# Per-project hooks belong in each repo's .config/wt.toml, not here.
worktree-path = "~/dev/worktrees/{{ remote_repo }}/{{ branch | sanitize }}"

[list]
# `summary` renders no column unless `full` is on: both gate on this flag.
full = true
summary = true
# Pinned so `wt list --format=json` consumers survive the upstream default flip.
json-schema = 2

[switch.picker]
pager = "delta --paging=never"

# Per-repo configs add their own excludes; the two lists combine.
[step.copy-ignored]
exclude = ["node_modules/", "dist/", ".turbo/"]

[aliases]
since-main = "git log --oneline {{ default_branch }}..HEAD"

# Aliases accumulate, user config first, and a failed step stops the rest: this review runs ahead of
# the project's own `ship` alias and stops it on an Important finding. The report is saved in the
# worktree's git dir, one file per commit; a commit whose report passed is not reviewed again.
# One ship without it: SHIP_SKIP_REVIEW=1 wt step ship.
[projects."dev.azure.com/*"]
aliases.ship = """
if [ -n "${SHIP_SKIP_REVIEW:-}" ]; then echo "Review skipped (SHIP_SKIP_REVIEW)" >&2; exit 0; fi
git fetch -q origin
BASE=$(git merge-base origin/{{ default_branch }} HEAD)
OUT=$(git rev-parse --absolute-git-dir)/review-$(git rev-parse --short HEAD).md
count() { sed -n 's/^IMPORTANT_FINDINGS=\\([0-9]*\\)$/\\1/p' "$OUT" 2>/dev/null | tail -1; }
if [ "$(count)" != 0 ]; then
  echo "Reviewing the branch against origin/{{ default_branch }} before the push (a few minutes)" >&2
  # The prompt goes first: --allowedTools takes every argument after it.
  claude -p "Run the mattpocock-skills:code-review skill with fixed point $BASE. This run is non-interactive: ask nothing; if no spec is found, skip the Spec axis and say so. Label every finding [Important] or [Minor]: Important is a hard violation of a documented standard (cite the file and rule) or a spec requirement that is missing or implemented wrong; baseline smells and judgement calls are Minor. End with exactly one line: IMPORTANT_FINDINGS=<count>" \
    --no-session-persistence --allowedTools 'Read Grep Glob Agent Skill Bash(git diff:*) Bash(git log:*) Bash(git show:*) Bash(git rev-parse:*) Bash(git merge-base:*) Bash(gh issue view:*)' > "$OUT"
fi
echo "Review: $OUT" >&2
N=$(count)
if [ "$N" != 0 ]; then
  echo "Refused: the review has ${N:-an unreadable count of} Important findings; nothing pushed. Fix them, or ship once without it: SHIP_SKIP_REVIEW=1 wt step ship" >&2
  exit 1
fi
"""

# --safe-mode keeps hooks/plugins/CLAUDE.md out of the generated text;
# --setting-sources='user' keeps auth out of a project .claude/settings.json.
[commit.generation]
command = "MAX_THINKING_TOKENS=0 claude -p --no-session-persistence --model=haiku --tools='' --safe-mode --setting-sources='user' --system-prompt=''"

<% if .orcaHelpers -%>
[pre-start]
# Warn-only: flag an existing branch sharing this branch's ticket number.
# `|| true` keeps an empty grep from aborting the create under set -e/pipefail.
collision-check = """
B={{ branch }}
T=$(printf '%s' "$B" | grep -oE 'gh[0-9]+|[0-9]{4,6}' | head -1 || true)
[ -z "$T" ] && exit 0
E=$(git branch -a --format='%(refname:short)' 2>/dev/null | grep -F "$T" | grep -vFx "$B" | grep -v HEAD | sort -u || true)
[ -z "$E" ] && exit 0
echo "⚠️ CONVERGE: work on ticket $T already exists —"
echo "$E" | sed 's/^/   • /'
echo "   Build on one of those, or Ctrl-C to abort this new '$B' worktree. (Warning only.)"
exit 0
"""

# Report only; removal stays with you. Skipped under Claude.
merged-report = """
if [ -n "${CLAUDECODE:-}" ]; then exit 0; fi
R=$(wt step prune --dry-run 2>&1 || true)
N=$(printf '%s\\n' "$R" | grep -c ' — ' || true)
[ "$N" -gt 0 ] || exit 0
echo "🧹 $N merged worktrees or branches can go — preview: wt step prune --dry-run · remove: wt step prune"
exit 0
"""
<% end -%>

# `.claude/` is globally ignored, so copy-ignored cannot deliver it to a new worktree.
# Copies, not symlinks: path-scoped rules do not load through a symlink leaving the worktree.
[post-start]
agent-guidance = """
P={{ primary_worktree_path }}
[ -d "$P/.claude/rules" ] || [ -d "$P/.claude/hooks" ] || exit 0
mkdir -p .claude
for e in rules hooks settings.json; do
  [ -L ".claude/$e" ] && rm ".claude/$e"
  [ -e "$P/.claude/$e" ] && cp -R "$P/.claude/$e" .claude/
done
exit 0
"""

<% if .orcaHelpers -%>
# A new worktree's Orca card: in progress, linked to the branch's gh<n> issue.
# Runs from any shell, not only an Orca terminal: `orca` is Orca's CLI, which in WSL talks to the Orca
# server there. Skipped where `orca` is a distro package, such as the GNOME screen reader.
orca-card = """
case "$(command -v orca)" in '' | /usr/*) exit 0 ;; esac
N=$(printf '%s' "{{ branch }}" | grep -oE 'gh[0-9]+' | head -1 | tr -d gh || true)
orca worktree set --worktree path:{{ worktree_path }} --workspace-status in-progress ${N:+--issue "$N"} >/dev/null 2>&1 || true
exit 0
"""
<% end -%>

# A table runs its entries concurrently, so a pipeline keeps the salvage ahead of the session close.
[[pre-remove]]
# Removal deletes untracked and ignored files without asking; a failed copy aborts the removal.
attic = "wt-attic {{ worktree_path }}"

[[pre-remove]]
<% if .orcaHelpers -%>
# Orca never closes an agent tab, and --reap spares processes holding a terminal.
orca-close = "orca-close-worktree {{ worktree_path }}"
<% end -%>
# An Azure merge never closes the GitHub issue a branch carries, so name it while it is still open.
issue-reminder = """
N=$(git -C "{{ worktree_path }}" branch --show-current 2>/dev/null | grep -oE 'gh[0-9]+' | head -1 | tr -d gh || true)
[ -n "$N" ] || exit 0
R=${GH_ISSUE_TRACKER_REPO:-$(mise exec -- printenv GH_ISSUE_TRACKER_REPO 2>/dev/null || true)}
# One merged slice does not finish an issue that has sub-issues, so a parent gets no reminder.
S=$(timeout 15 gh api "repos/$R/issues/$N" --jq '[.state, .sub_issues_summary.total] | map(tostring) | join(" ")' 2>/dev/null || true)
[ "$S" = "open 0" ] && echo "GH-$N is still open: gh issue close $N --repo $R"
exit 0
"""
