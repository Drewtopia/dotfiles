[[ -o interactive ]] || return

[[ -n "$ZPROF" ]] && zmodload zsh/zprof

export ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"
# p10k instant prompt: anything that may prompt for console input must go above.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH=$HOME/.oh-my-zsh

ZSH_THEME="powerlevel10k/powerlevel10k"

# chezmoi externals refresh oh-my-zsh; its own updater would fight them.
DISABLE_AUTO_UPDATE="true"

HIST_STAMPS="yyyy-mm-dd"

ZSH_DISABLE_COMPFIX=true

# oh-my-zsh plugins come from the zinit snippets below, not ~/.oh-my-zsh/plugins.
plugins=()

ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
source "$ZINIT_HOME/zinit.zsh"

# Must be set before the plugin loads.
export ZSH_TMUX_FIXTERM=false

{{- range .zshPlugins }}
zinit snippet OMZP::{{ . }}
{{- end }}

# Runs compinit, which carapace (in shell/020-shell-tools.sh) needs first.
source $ZSH/oh-my-zsh.sh

zinit cdreplay -q

# fzf-tab must load after compinit (run by oh-my-zsh.sh above) and before
# anything that wraps widgets.
zinit light Aloxaf/fzf-tab

PROMPT="%{$fg[white]%}%n@%{$fg[green]%}%m%{$reset_color%} ${PROMPT}"

setopt autocd
setopt histignorespace
setopt rm_star_silent

alias zshconfig='"$EDITOR" ~/.zshrc'
alias zshrc="source ~/.zshrc"

source "${XDG_CONFIG_HOME}/shell-loader.sh"

# `command wt`: bypass the wt shell function the integration defines.
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

[[ -f "${HOME}/.zshrc.local" ]] && source "${HOME}/.zshrc.local"
[[ -f "${HOME}/.dotfiles.local" ]] && source "${HOME}/.dotfiles.local"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# zsh-syntax-highlighting's install docs require it last: on zsh < 5.9 it wraps
# only the widgets defined before it.
zinit light zsh-users/zsh-syntax-highlighting

[[ -n "$ZPROF" ]] && zprof || true

{{- /* vim: set filetype=zsh: */}}
