.tmux.config

# Old fzf configs (replaced by eval "$(fzf --zsh)")
.fzf.zsh
.fzf.bash

# Prevent stale ~/.gitconfig from shadowing chezmoi-managed
# ~/.config/git/config (git prefers ~/.gitconfig when both exist).
# Git-for-Windows installer can re-create this on reinstall.
.gitconfig

# Old custom.paths.sh (deleted from chezmoi source)
.config/shell/paths/custom.paths.sh

{{- if eq .chezmoi.os "linux" }}
# Old chezmoi-external binaries now handled by mise
.local/bin/age
.local/bin/age-keygen
.local/bin/croc
.local/bin/eza
.local/bin/gdu
.local/bin/glow
.local/bin/golangci-lint
.local/bin/jless
.local/bin/uv
.local/bin/delta
.local/bin/lazygit
.local/bin/yt-dlp
.local/bin/jj
.local/bin/carapace
{{- end }}

# .atuin already removed — don't re-prompt

# Old PATH management files (consolidated into shell/000-paths.sh + .zshenv)
.config/path-management.sh
.config/shell/paths

# Old unnumbered shell configs (replaced by numbered equivalents)
.config/shell/060-common_aliases.sh
.config/shell/cheatsheets.sh
.config/shell/dev-tools.sh
.config/shell/mise.sh
.config/shell/shell-tools.sh
.config/shell/system-tools.sh

# prd-to-issues replaced by to-issues (mattpocock renamed Apr 2026)
.claude/skills/prd-to-issues

# mattpocock/skills v1.0.0 (Jun 2026 "design skills" refactor) removed/renamed these.
# Remove both the ~/.claude/skills symlink AND the ~/.agents/skills payload that
# `npx skills` leaves behind (chezmoi doesn't manage the .agents store, so dropping
# a skill from skills.yaml otherwise orphans the payload on every machine).
.claude/skills/write-a-skill
.claude/skills/diagnose
.claude/skills/zoom-out
.agents/skills/write-a-skill
.agents/skills/diagnose
.agents/skills/zoom-out

# mattpocock/skills v1.1.0 (Jul 2026): to-issues + to-prd unified upstream
# into to-spec + to-tickets. Same dual-path removal as above.
.claude/skills/to-issues
.claude/skills/to-prd
.agents/skills/to-issues
.agents/skills/to-prd

# writing-great-skills is upstream's retired name for writing-for-agents.
.claude/skills/writing-great-skills
.agents/skills/writing-great-skills

# mattpocock/skills v1.2.0 (Jul 2026): the stable engineering/ + productivity/
# skills moved from `npx skills` to the mattpocock-skills@mattpocock plugin
# (see .chezmoidata/claude.toml). Sweep the Claude-side symlinks so they don't
# shadow the plugin's namespaced versions with a stale duplicate. Mirrors the
# names in upstream's .claude-plugin/plugin.json — misc/ and in-progress/ are
# deliberately absent, they stay on the `npx skills` path for Claude.
#
# Symlink only, NOT the ~/.agents/skills payload: skills.yaml now installs the
# whole repo for Codex, Cursor and GitHub Copilot, which read that store
# directly. Deleting the payload here would uninstall it from them on every
# apply.
#
# Aug 2026: wizard graduated in-progress/ → engineering/ and to-questionnaire
# graduated into productivity/, so the plugin now covers both. Those two had to
# be picked up with an uninstall+reinstall: upstream grew plugin.json while
# still calling it 1.2.0, and `claude plugin update` compares only the version
# string. Upstream has since added scripts/sync-plugin-version.mjs to stamp the
# release version into plugin.json, so 1.2.2 (which added wait-what) updated
# normally. If a future skill fails to appear, suspect that sync first.
{{- $pluginSkills := list
  "ask-matt" "code-review" "codebase-design" "diagnosing-bugs" "domain-modeling"
  "grill-with-docs" "implement" "improve-codebase-architecture" "prototype"
  "research" "resolving-merge-conflicts" "setup-matt-pocock-skills" "tdd"
  "to-spec" "to-tickets" "triage" "wayfinder" "wizard"
  "grill-me" "grilling" "handoff" "teach" "to-questionnaire" "wait-what"
  "writing-for-agents" }}
{{- range $pluginSkills }}
.claude/skills/{{ . }}
{{- end }}
