{{- if .work }}
  {{- /* Personal claude.ai connectors stay off work machines. Match by URL: connector
         display names come from claude.ai and can change or gain a " (N)" suffix. */}}
  "deniedMcpServers": [
    { "serverUrl": "https://api.fastmail.com/*" },
    { "serverUrl": "https://ai.todoist.net/*" },
    { "serverUrl": "https://*.supabase.co/functions/v1/open-brain-mcp*" }
  ],
{{- end }}
  "autoUpdatesChannel": "latest",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "agentPushNotifEnabled": false,
  {{- /* NOTE: effectively never: also disables the orphaned-worktree sweep. Prune
         transcripts with `claude purge`, worktrees with `wt step prune`. */}}
