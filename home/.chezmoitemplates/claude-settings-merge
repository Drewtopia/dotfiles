CHEZMOI_SETTINGS_EOF
)

existing=$(cat)
# case, not ${existing//[[:space:]]/}: that substitution is quadratic in bash
# (40KB of settings pegged a core indefinitely; case is ~5ms).
case "$existing" in *[![:space:]]*) ;; *) existing='{}' ;; esac

printf '%s' "$existing" | jq --argjson m "$managed" '
  # Keys of b then of a, each once, so the runtime key order stays byte-clean.
  def keys_of(a;b):
    (b|keys_unsorted)+(a|keys_unsorted) | reduce .[] as $x ([]; if any(.[];.==$x) then . else .+[$x] end);
  # dm(a;b): merge managed (a) as a floor under runtime (b). b (runtime) wins.
  def dm(a;b):
    if (a|type)=="object" and (b|type)=="object" then
      reduce keys_of(a;b)[] as $k ({};
        .[$k] = (if   (b|has($k)) and (a|has($k)) then dm(a[$k]; b[$k])
                 elif (b|has($k))                 then b[$k]
                 else                                  a[$k] end))
    elif (a|type)=="array" and (b|type)=="array" then b + (a - b)
    else b end;
  # A runtime hook to drop: a copy of a managed one (its managed group is appended
  # whole, in its own event), a script from ~/.claude/hooks that chezmoi no longer
  # lists, or a retired hook that lived elsewhere. dcg is not managed here: each dcg
  # run rewrites its own entry to its binary path, so only the old shim form retires.
  def dropped($managed):
    (.command // "") as $c
    | ($managed | index($c)) != null
      or ($c | test("(\\$HOME/\\.claude\\}\"?|~/\\.claude)/hooks/"))
      or any(
           "tmux rename-window \"cc:", "tmux set-option -w automatic-rename on",
           "-name '\''*.sh'\'' ! -executable", "EnterWorktree without path",
           "/shims/dcg", "check-onboard-drift", "claude-log-session", "test -d .jj",
           ".claude-vault/hooks/";
           . as $r | $c | contains($r));
  # Per event: runtime groups minus dropped hooks, then the managed groups.
  def merge_hooks(a;b):
    [a[][]?.hooks[]?.command // empty] as $mc
    | reduce keys_of(a;b)[] as $ev ({};
      ([ (b[$ev] // [])[] | .hooks = [ (.hooks // [])[] | select(dropped($mc) | not) ]
           | select(.hooks | length > 0) ] + (a[$ev] // [])) as $v
      | if ($v | length) > 0 then .[$ev] = $v else . end);
  # bind runtime input to $e first: jq args are call-by-name filters, so passing
  # "." rebinds b to the reduce accumulator mid-merge and drops runtime-only keys.
  . as $e | dm($m; $e)
  | .hooks = merge_hooks($m.hooks; $e.hooks // {})
  # Permission tombstones: non-hook arrays union, so a retired rule stays in live
  # settings unless it is stripped here.
  # The Edit(...) ask rules did not prompt in an SDK-hosted auto-mode session.
  | .permissions.ask = ((.permissions.ask // []) | map(select(startswith("Edit(//**/") | not)))
  # The cwd-relative **/ rules became //**/ (filesystem-wide, as the retired block-secrets
  # hook was); Read(**/.env.*) also denied .env.example; a Read deny already denies Edit.
  | .permissions.deny -= ["Write(**/.env)", "Write(**/.env.*)",
      "Read(**/.env)", "Read(**/.env.*)", "Read(**/secrets/**)",
      "Edit(**/.env)", "Edit(**/.env.*)"]
  # The sandbox turns Read denies into OS read-denies: .git/config broke every git and
  # gh call, and //**/*.pem hid the system CA bundle (/etc/ssl/cert.pem).
  | .permissions.deny -= ["Read(//**/.git/config)", "Read(//**/*.pem)"]
{{- if eq .chezmoi.os "darwin" }}
  # Commit signing reads ~/.ssh/git_signing (written from 1Password by chezmoi);
  # the Read denies on id_* still keep the SSH auth keys out of the sandbox.
  | if .sandbox.filesystem.denyRead then .sandbox.filesystem.denyRead -= ["~/.ssh"] else . end
  # Retired pilot entries: signing never used the 1Password agent, and ssh -o
  # ProxyCommand= ran anything outside the sandbox.
  | if .sandbox.network.allowUnixSockets then .sandbox.network.allowUnixSockets -= ["{{ .chezmoi.homeDir }}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"] else . end
  | if .sandbox.excludedCommands then .sandbox.excludedCommands -= ["ssh *", "op *", "fnox *", "chezmoi *"] else . end
  # The vault retired into hub (~/repos/drew/hub, which ~/repos already covers). Its hooks
  # run unsandboxed, so their real path is write-denied; ~/.hub is only a symlink to it.
  | if .sandbox.filesystem.allowWrite then .sandbox.filesystem.allowWrite -= ["~/.claude-vault"] else . end
  | if .sandbox.filesystem.denyWrite then .sandbox.filesystem.denyWrite -= ["~/.claude-vault/hooks"] else . end
{{- end }}
  # Pinned scalars: the floor merge lets runtime win on scalar conflicts, so a
  # changed managed default cannot move an already-set live value. Force the few
  # keys chezmoi must own regardless of runtime drift.
  | .preferredNotifChannel = "auto"
  # The status line runs on every repaint of every session: pin the installed
  # binary so a stale runtime value cannot keep a registry lookup per repaint.
  | .statusLine = $m.statusLine
  # hookify has no rules anywhere but spawns python3 around every tool call;
  # a runtime `true` would otherwise outrank the managed `false`.
  | .enabledPlugins["hookify@claude-plugins-official"] = false
  # Retired plugins a runtime `true` would otherwise keep enabled.
  | .enabledPlugins["session-report@claude-plugins-official"] = false
  | .enabledPlugins["humanizer@humanizer"] = false
  | .enabledPlugins["andrej-karpathy-skills@karpathy-skills"] = false
  # Caveman is uninstalled; the floor merge never drops a key, so remove its leftovers.
  | del(.enabledPlugins["caveman@caveman"], .extraKnownMarketplaces.caveman)
  # Attribution stays off in every form. sessionUrl defaults to true and the
  # deprecated includeCoAuthoredBy never covered it, so web and Remote Control
  # commits still carried a session trailer. Pin the whole object (runtime wins
  # per scalar otherwise) and drop the superseded key from live settings.
  | .attribution = { "commit": "", "pr": "", "sessionUrl": false }
  | del(.includeCoAuthoredBy)
' | tr -d '\r'
