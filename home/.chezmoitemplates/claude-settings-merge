{{- end }}
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(pnpm run :*)",
      "Bash(cargo :*)",
      "Bash(go :*)",
      "Bash(git :*)",
      "Bash(wt :*)",
      "Bash(gh :*)",
