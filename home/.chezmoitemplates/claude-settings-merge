  {{- /* Seeds, not pins: the floor merge lets runtime win per scalar, so these
         only reach a machine that has not set its own. */}}
  "tui": "fullscreen",
  "theme": "dark",
  "worktree": {
    "baseRef": "fresh"
  },
  {{- /* A CLAUDE.local.md stops AGENTS.md loading under the default; this loads both. */}}
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    },
    {{- /* T3's PR tools need the real Azure URL to link or watch a PR; the default list holds no MCP tool. */}}
    "redact@redact": {
      "options": {
        "restoreTools": "Bash,PowerShell,Write,Edit,MultiEdit,NotebookEdit,Read,Glob,Grep,mcp__t3-code__link_pull_request,mcp__t3-code__watch_pull_request"
