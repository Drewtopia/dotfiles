      "mcp__azure-devops__work_capacity_write"
    ],
    "deny": [
      "Bash(> /dev/sda*)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.development)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Read(//**/secrets/**)",
      "Read(//**/secrets.json)",
      "Read(//**/secrets.yaml)",
      "Read(//**/secrets.yml)",
      "Read(//**/secrets.toml)",
      "Read(//**/.secrets)",
      "Read(//**/credentials.json)",
      "Read(//**/credentials.yaml)",
      "Read(//**/service-account.json)",
      "Read(//**/service_account.json)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_ecdsa)",
      "Read(//**/id_dsa)",
      "Read(~/**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.jks)",
      "Read(//**/*.keystore)",
      "Read(~/.npmrc)",
      "Read(~/.yarnrc)",
      "Read(//**/.pypirc)",
      "Read(//**/.docker/config.json)",
      "Read(//**/.aws/credentials)",
      "Read(//**/gcloud/credentials.db)",
      "Read(//**/.azure/credentials)",
      "Read(//**/.git-credentials)",
      "Read(//**/.pgpass)",
      "Read(//**/.my.cnf)",
      "Read(//**/.mongorc.js)",
      "Read(//**/mise.local.toml)",
      "Read(//**/config.local.toml)"
    ]
  },
  {{- /* onFailure "block": a guard that cannot start (node off the hook PATH) or hangs
         blocks the call instead of letting it through. */}}
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/pre-bash-dispatcher.js\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/hooks/git-commit-precheck.sh"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/dcg-unattended-ask.js\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Artifact|mcp__claude_ai_Claude_Docs__.*|mcp__.*__wit_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/work-safety-ask.js\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/edit-governance-guard.cjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.hub/hooks/block-windows-root-files.cjs\"; [ ! -f \"$f\" ] || node \"$f\""
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "edit-governance|audit-rules-and-skills|reorganize-memory",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/edit-governance-guard.cjs\" --expansion"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/post-edit-format.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/stop-verify.js\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/stop-reply-paths.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
{{- if ne .chezmoi.os "windows" }}
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/worktree-guidance-topup.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/session-start-mistakes.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/session-start-behind.sh\"",
            "timeout": 10
          }
        ]
      }
{{- end }}
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "command -v ccstatusline >/dev/null 2>&1 && exec ccstatusline || exec bun x ccstatusline@2.2.29",
    "padding": 0,
    "refreshInterval": 30
  },
  {{- /* enabledPlugins: merge profile-gated plugin tables from claude.toml */ -}}
  {{- $enabled := dict -}}
  {{- range $k, $v := .plugins.always -}}{{- $_ := set $enabled $k $v -}}{{- end -}}
  {{- if .personal -}}{{- range $k, $v := .plugins.personal -}}{{- $_ := set $enabled $k $v -}}{{- end -}}{{- end -}}
  {{- if .dev_computer -}}{{- range $k, $v := .plugins.dev_computer -}}{{- $_ := set $enabled $k $v -}}{{- end -}}{{- end }}
