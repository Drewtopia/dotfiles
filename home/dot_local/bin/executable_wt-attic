#!/usr/bin/env bash
# Copies the untracked and gitignored files a worktree removal would lose into
# ~/dev/worktree-salvage/<repo>/<branch>-<time>/ before worktrunk's pre-remove lets it go.
# Skipped: build output and dependency dirs, Playwright session caches (cookies), and files
# byte-identical to the primary checkout's copy (the .worktreeinclude copies).
# Usage: wt-attic [-n] [<worktree-path>]   -n lists what would be archived and copies nothing.
set -euo pipefail

dry=0
[ "${1:-}" = "-n" ] && { dry=1; shift; }
wt=$(git -C "${1:-.}" rev-parse --show-toplevel)
main=$(git -C "$wt" worktree list --porcelain | awk '/^worktree / && !n++ {print substr($0,10)}')
[ "$wt" = "$main" ] && { echo "wt-attic: $wt is the primary checkout; nothing to archive" >&2; exit 0; }

regen='(^|/)(node_modules|dist|\.moon/cache|\.astro|\.turbo|playwright-report|test-results|blob-report|playwright/\.auth)/|\.tsbuildinfo$'
g() { git -C "$wt" -c core.quotePath=false "$@"; }

files=$(
  {
    g ls-files -o --exclude-standard
    g ls-files -o -i --exclude-standard --directory | { grep -Ev "$regen" || true; } | while IFS= read -r p; do
      if [[ $p == */ ]]; then (cd "$wt" && find "$p" -type f); else printf '%s\n' "$p"; fi
    done
  } | { grep -Ev "$regen" || true; } | while IFS= read -r p; do
    cmp -s "$wt/$p" "$main/$p" || printf '%s\n' "$p"
  done
)
[ -n "$files" ] || exit 0

if ((dry)); then printf '%s\n' "$files"; exit 0; fi

branch=$(git -C "$wt" branch --show-current)
dest="$HOME/dev/worktree-salvage/$(basename "$main")/${branch//\//-}-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$dest"
chmod 700 "${dest%/*/*}"
printf 'repo=%s\nbranch=%s\nworktree=%s\n' "$main" "$branch" "$wt" > "$dest/.wt-attic"
(cd "$wt" && printf '%s\n' "$files" | while IFS= read -r p; do cp -p --parents -- "$p" "$dest/"; done)
echo "📦 archived $(printf '%s\n' "$files" | wc -l) untracked/ignored files → $dest"
