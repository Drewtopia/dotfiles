#!/usr/bin/env bash
# Removes agent-<id> worktrees: Claude Code fires no WorktreeRemove when an
# isolated subagent finishes. Lists by default; `-y` removes via `wt remove`, so
# pre-remove hooks run and unmerged branches are kept.
set -euo pipefail

remove=0
[ "${1:-}" = "-y" ] && remove=1

# A subagent that is still running sits in its worktree; so may a shell or editor.
cwds=$(lsof -a -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' || true)

git worktree list --porcelain |
  awk '/^worktree /{p=substr($0,10)} /^branch refs\/heads\//{b=substr($0,19); if (b ~ /^agent-[0-9a-f]{17}$/) print b "\t" p}' |
  while IFS=$'\t' read -r branch path; do
    if printf '%s\n' "$cwds" | awk -v p="$path" 'index($0, p) == 1 {found=1} END {exit !found}'; then
      echo "skip    $branch  (a process is working in it)"
    elif [ -n "$(git -C "$path" status --porcelain)" ]; then
      echo "skip    $branch  (uncommitted changes)"
    elif [ -z "$(find "$path/.git" -maxdepth 0 -mmin +60)" ]; then
      echo "skip    $branch  (created in the last hour)"
    elif [ "$remove" = 1 ]; then
      wt remove --foreground "$branch"
    else
      echo "remove  $branch  $path"
    fi
  done

[ "$remove" = 1 ] || echo "(dry run — pass -y to remove)"
