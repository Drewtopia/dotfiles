#!/usr/bin/env bash
# Opens a branch's Claude session in Orca, creating the branch and worktree when needed.
# Usage: orca-new <branch> [--title <t>] [--model <id>] [--effort <lvl>]
#                 [--prompt <text> | --prompt-file <f>] [--base <ref>] [--issue <n>]
#   --issue links the tracker issue to the Orca card; branch names no longer carry it.
#   live Claude session on the branch -> switch to it (one session per branch; a brief is refused)
#   worktree, no live session         -> `claude --continue` there, or a fresh session when a
#                                        model or brief is given
#   branch (local or origin) only     -> `wt switch` makes the worktree, then a fresh session
#   new branch                        -> `orca worktree create` from --base (default origin/HEAD)
# The tab is titled --title, else the branch without its type and scope:
#   feat/billing-12345-invoice-export -> "12345 invoice export"
set -euo pipefail

die() { echo "orca-new: $1" >&2; exit "${2:-1}"; }
# Echo each Orca/git command before it runs; long arguments (a brief) are shortened.
run() {
  local a s=+
  for a; do [ ${#a} -le 120 ] || a="${a:0:117}..."; s+=" $(printf '%q' "$a")"; done
  echo "$s" >&2
  "$@"
}

b=${1:-}
case "$b" in '' | -*) die "usage: orca-new <branch> [--title <t>] [--model <id>] [--effort <lvl>] [--prompt <text> | --prompt-file <f>] [--base <ref>] [--issue <n>]" 2 ;; esac
shift
title='' base='' brief='' issue='' launch=()
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || die "$1 needs a value" 2
  case "$1" in
    --title) title=$2 ;;
    --base) base=$2 ;;
    --issue) case "$2" in *[!0-9]* | '') die "--issue needs a number" 2 ;; esac; issue=$2 ;;
    --model | --effort) launch+=("$1" "$2") ;;
    --prompt) brief=$2 ;;
    --prompt-file) [ -s "$2" ] || die "--prompt-file needs a non-empty file" 2; brief=$(cat "$2") ;;
    *) die "unknown option $1" 2 ;;
  esac
  shift 2
done
[ -z "$brief" ] || launch+=(--prompt "$brief")

worktree_of() {
  git worktree list --porcelain | awk -v r="branch refs/heads/$1" '/^worktree /{w = substr($0, 10)} $0 == r {print w}'
}

wt_path=$(worktree_of "$b")
[ -z "$wt_path" ] || [ -z "$base" ] || die "--base only applies to a new branch; $b has a worktree" 2
fresh=0
if [ -z "$wt_path" ]; then
  exists=0
  case "$b" in
    pr:* | mr:*) exists=1 ;;
    *) git rev-parse --verify --quiet "refs/heads/$b" >/dev/null ||
         git rev-parse --verify --quiet "refs/remotes/origin/$b" >/dev/null && exists=1 ;;
  esac
  [ "$exists" = 0 ] || [ -z "$base" ] || die "--base only applies to a new branch; $b exists" 2
  fresh=1
  if [ "$exists" = 1 ]; then
    # `orca worktree create` cannot check out an existing branch.
    wt_path=$(run wt switch "$b" --no-cd --format=json | jq -r .path)
    case "$wt_path" in '' | null) die "wt switch $b gave no worktree" ;; esac
    b=$(git -C "$wt_path" branch --show-current)
    # Orca finds a worktree it did not create on its next poll, some seconds later.
    i=0
    until orca worktree show --worktree "path:$wt_path" >/dev/null 2>&1; do
      i=$((i + 1))
      [ "$i" -lt 30 ] || die "Orca has not picked up $wt_path after 30 s; open it there"
      sleep 1
    done
    [ -z "$issue" ] || run orca worktree set --worktree "path:$wt_path" --issue "$issue" >/dev/null
  else
    # Under Claude, a new branch for a ticket that already has a worktree is refused: a second
    # worktree means a second session on the same work. Drew gets worktrunk's warning only.
    if [ -n "${CLAUDECODE:-}" ]; then
      t=$(printf '%s' "$b" | grep -oE 'gh[0-9]+|[0-9]{4,6}' | head -1 || true)
      w=''
      [ -z "$t" ] || w=$(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p' |
        grep -E "(^|[^0-9a-z])$t([^0-9]|$)" || true)
      [ -z "$w" ] || die "ticket $t already has a worktree (${w//$'\n'/ }); carry on there, or ask Drew"
      if [ -n "$issue" ] && w=$(orca worktree show --worktree "issue:$issue" --json 2>/dev/null | jq -r '.result.worktree.path // empty') && [ -n "$w" ]; then
        die "GH-$issue already has a worktree ($w); carry on there, or ask Drew"
      fi
    fi
    if [ -z "$base" ]; then
      base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) ||
        die "no origin/HEAD; pass --base, or run: git remote set-head origin --auto"
    fi
    out=$(run orca worktree create --name "${b//\//-}" --no-parent --base-branch "$base" --setup run \
      --agent claude ${issue:+--issue "$issue"} ${launch[@]+"${launch[@]}"} --surface terminal --json)
    wt_path=$(jq -r .result.worktree.path <<<"$out")
    handle=$(jq -r '.result.launch.outcome.handle // empty' <<<"$out")
    # Orca turns / into - and may add its branch prefix, so rename from the branch it reports.
    made=$(jq -r '.result.worktree.branch // empty' <<<"$out")
    made=${made#refs/heads/}
    [ -n "$made" ] || made=$(git -C "$wt_path" branch --show-current)
    [ "$made" = "$b" ] || run git -C "$wt_path" branch -m "$made" "$b"
  fi
fi

if [ -z "${handle:-}" ]; then
  # Orca keeps a tab's agentIdentity after Claude exits, so Claude's own live-session records
  # (pid and cwd) say whether one runs here; Orca then names the tab.
  cc=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  running=0
  for r in "$cc"/sessions/*.json; do
    [ -e "$r" ] || continue
    read -r pid cwd < <(jq -r '"\(.pid) \(.cwd)"' "$r" 2>/dev/null) || continue
    case "$cwd" in "$wt_path" | "$wt_path"/*) kill -0 "$pid" 2>/dev/null && { running=1; break; } ;; esac
  done
  if [ "$running" = 1 ]; then
    handle=$(orca terminal list --worktree "path:$wt_path" --json | jq -r '
      [.result.terminals[] | select((.orphaned | not) and .agentIdentity == "claude")]
      | max_by(.lastOutputAt) | .handle // empty')
    [ -n "$handle" ] || die "$b already has a live Claude session (an Orca chat, or outside Orca); carry on there"
    if [ ${#launch[@]} -gt 0 ]; then
      run orca terminal switch --terminal "$handle" >/dev/null
      die "$b already has a live Claude session; switched to it: give it the brief there, or close it first"
    fi
    echo "orca-new: $b already has a live Claude session; switching to it" >&2
  elif [ "$fresh" = 1 ] || [ ${#launch[@]} -gt 0 ]; then
    out=$(run orca agent launch --agent claude --worktree "path:$wt_path" ${launch[@]+"${launch[@]}"} --surface terminal --json)
    handle=$(jq -r '.result.outcome.handle // .result.launch.outcome.handle // empty' <<<"$out")
  else
    # Interactive `claude --continue` exits at once in a folder with no saved session.
    resume=claude
    compgen -G "$cc/projects/$(printf '%s' "$wt_path" | tr -c 'A-Za-z0-9' -)/*.jsonl" >/dev/null && resume="claude --continue"
    out=$(run orca terminal create --worktree "path:$wt_path" --command "$resume" --json)
    handle=$(jq -r '.result.terminal.handle // .result.handle // empty' <<<"$out")
  fi
fi
[ -n "$handle" ] || die "Orca returned no terminal handle: $out"

if [ -z "$title" ]; then
  # Drop the <type>/ prefix, then any scope before the ticket number; Drew finds tabs by 2-4 words.
  title=${b#*/}
  t=$(printf '%s' "$title" | grep -oE 'gh[0-9]+|[0-9]{4,6}' | head -1 || true)
  [ -z "$t" ] || title=$t${title#*"$t"}
  title=$(printf '%s' "$title" | tr -s -- '-_/' ' ' | cut -d' ' -f1-4)
fi
# Created without focus: revealing a worktree with no tabs makes Orca open a second, default tab.
run orca terminal switch --terminal "$handle" >/dev/null
run orca terminal rename --terminal "$handle" --title "$title" >/dev/null
