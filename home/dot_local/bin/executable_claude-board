#!/usr/bin/env python3
"""claude-board — an interactive local HTML board of your Claude Code sessions.

Gathers every session (`claude agents --json --all`), its git state, the ticket
or PR it relates to, its closeout-log status, and a digest from `claude-tail`,
then renders a self-contained, offline HTML file and prints its path. Read-only:
it never stops, removes, or edits a session.

  claude-board              # render and print the path (opens it if a viewer is found)
  claude-board --no-open    # render only
  claude-board --prs        # add a table of your active Azure PRs, tied to sessions
  claude-board --summarise  # one batched `claude -p --model sonnet` call adds a
                            # 'done -> next' summary per session and a triage banner

Links to PRs, issues, and work items are derived from each checkout's git
remote and $GH_ISSUE_TRACKER_REPO — no host or org is baked into this file.
"""
import html
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone

LOG = os.path.expanduser("~/.claude/memory/SESSION_LOG.md")
OUT = os.path.expanduser("~/.cache/claude/board.html")
GH_REPO = os.environ.get("GH_ISSUE_TRACKER_REPO", "")


def sh(args, cwd=None):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=15, cwd=cwd)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (subprocess.SubprocessError, OSError):
        return ""


def azure_ids(remote):
    """(org, project, repo) from an Azure DevOps remote, else None."""
    # https://org@dev.azure.com/org/Project/_git/Repo  |  git@ssh.dev.azure.com:v3/org/Project/Repo
    m = re.search(r"dev\.azure\.com/([^/@]+)/([^/]+)/_git/([^/\s]+)", remote)
    if m:
        return m.groups()
    m2 = re.search(r"ssh\.dev\.azure\.com:v3/([^/]+)/([^/]+)/([^/\s]+)", remote)
    return m2.groups() if m2 else None


def azure_bases(remote):
    """(pr_base, wi_base) from an Azure DevOps remote, else (None, None)."""
    ids = azure_ids(remote)
    if not ids:
        return None, None
    org, proj, repo = ids
    base = f"https://dev.azure.com/{org}/{proj}"
    return f"{base}/_git/{repo}/pullrequest/", f"{base}/_workitems/edit/"


def git_info(cwd):
    if not cwd or not os.path.isdir(cwd):
        return {"gone": True, "branch": "", "dirty": 0, "unpushed": 0, "pr_base": None, "wi_base": None}
    branch = sh(["git", "-C", cwd, "branch", "--show-current"])
    status = sh(["git", "-C", cwd, "status", "--porcelain"])
    dirty = len([l for l in status.splitlines() if l.strip()])
    up = sh(["git", "-C", cwd, "rev-list", "--count", "@{u}..HEAD"])
    unpushed = int(up) if up.isdigit() else 0
    pr_base, wi_base = azure_bases(sh(["git", "-C", cwd, "remote", "get-url", "origin"]))
    return {"gone": False, "branch": branch, "dirty": dirty, "unpushed": unpushed,
            "pr_base": pr_base, "wi_base": wi_base}


def tail(sid):
    out = sh(["claude-tail", sid])
    d = {"point": "", "last_user": "", "last_asst": "", "has": bool(out)}
    for line in out.splitlines():
        if line.startswith("POINT: "):
            d["point"] = line[7:]
        elif line.startswith("LAST-USER: "):
            d["last_user"] = line[11:]
        elif line.startswith("LAST-ASSISTANT: "):
            d["last_asst"] = line[16:]
    return d


def refs(branch, point):
    """PR / issue / work-item ids from the branch name and the POINT line only."""
    prs, issues, wis = set(), set(), set()
    for m in re.finditer(r"(?:pullrequest/|PR ?#?)(\d{3,5})", point):
        prs.add(m.group(1))
    for m in re.finditer(r"(?:GH-|PRD #|#)(\d{2,4})\b", point):
        issues.add(m.group(1))
    for m in re.finditer(r"\b(\d{5})\b", branch + " " + point):
        wis.add(m.group(1))
    return {"prs": sorted(prs), "issues": sorted(issues), "wis": sorted(wis - prs)}


def logged(name, cwd, point):
    if not os.path.isfile(LOG):
        return {"status": "?", "title": "", "summary": ""}
    text = open(LOG, encoding="utf-8").read()
    proj = os.path.basename(cwd) if cwd else ""
    if proj and proj != "AutomatedTesting" and proj in text:
        title, summary = _entry_for(text, proj)
        return {"status": "logged", "title": title, "summary": summary}
    if proj == "AutomatedTesting":
        return {"status": "ambiguous", "title": "", "summary": ""}
    return {"status": "missing", "title": "", "summary": ""}


def _entry_for(text, proj):
    """(title, summary) of the SESSION_LOG entry whose Project line names proj.
    An entry is a '## <date> — <title>' block; summary is the prose before the
    '- Machine' bullet list. Prefers a persisted 'Next:' line when present."""
    for block in ("\n" + text).split("\n## ")[1:]:
        if not any(l.strip().lower().startswith("- project") and proj in l
                   for l in block.splitlines()):
            continue
        head, _, rest = block.partition("\n")
        title = head.split(" — ", 1)[-1].strip()
        prose = rest.split("\n- Machine", 1)[0].strip()
        nxt = next((l.split("Next:", 1)[1].strip() for l in prose.splitlines()
                    if l.strip().startswith("Next:")), "")
        return title, (nxt or " ".join(prose.split()))
    return "", ""


def section(state, gi):
    if state in ("", "?", None) or gi["gone"]:
        return 4  # dead
    if state == "blocked":
        return 0  # needs you
    if state == "working":
        return 1
    dirty = gi["dirty"] or gi["unpushed"]
    return 2 if dirty else 3  # done-leftover / done-clean


SECTIONS = ["Needs you", "Working", "Done — unsaved", "Done — clean", "Dead / stale"]


def age_of(started):
    if not started:
        return "?"
    try:
        if isinstance(started, (int, float)):
            ts = started / 1000 if started > 1e12 else started
            t = datetime.fromtimestamp(ts, timezone.utc)
        else:
            t = datetime.fromisoformat(str(started).replace("Z", "+00:00"))
        mins = int((datetime.now(timezone.utc) - t).total_seconds() // 60)
    except (ValueError, OverflowError, OSError):
        return "?"
    if mins < 0:
        return "?"
    if mins >= 1440:
        return f"{mins // 1440}d"
    if mins >= 60:
        return f"{mins // 60}h"
    return f"{mins}m"


def days_since(iso):
    if not iso:
        return None
    try:
        t = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
        return max(0, (datetime.now(timezone.utc) - t).days)
    except ValueError:
        return None


def conflicts(rows):
    """Checkouts held live by 2+ sessions while dirty/unpushed — ref-move risk."""
    live = {}
    for r in rows:
        if r["state"] in ("working", "blocked") and r["cwd"]:
            live.setdefault(r["cwd"], []).append(r)
    out = []
    for cwd, rs in live.items():
        if len(rs) >= 2 and any(x["dirty"] or x["unpushed"] for x in rs):
            out.append((rs[0]["branch"] or cwd, [x["name"] for x in rs]))
    return out


def gather():
    raw = sh(["claude", "agents", "--json", "--all"])
    if not raw:
        sys.exit("claude-board: `claude agents` returned nothing")
    rows = []
    gitcache = {}
    for s in json.loads(raw):
        cwd = s.get("cwd") or ""
        sid = s.get("sessionId") or s.get("id") or ""
        gi = gitcache.get(cwd)
        if gi is None:
            gi = git_info(cwd)
            gitcache[cwd] = gi
        t = tail(sid)
        rows.append({
            "state": s.get("state") or "?",
            "name": s.get("name") or "(unnamed)",
            "cwd": cwd, "sid": sid,
            "age": age_of(s.get("startedAt")),
            "branch": gi["branch"], "dirty": gi["dirty"], "unpushed": gi["unpushed"],
            "gone": gi["gone"], "pr_base": gi["pr_base"], "wi_base": gi["wi_base"],
            **t,
            "refs": refs(gi["branch"], t["point"]),
            "logged": logged(s.get("name") or "", cwd, t["point"]),
            "sec": section(s.get("state"), gi),
        })
    rows.sort(key=lambda r: (r["sec"], -(r["dirty"] + r["unpushed"])))
    return rows


def branch_session_map(rows):
    """branch -> (session name, state), preferring a blocked/working session."""
    order = {"blocked": 0, "working": 1}
    best = {}
    for r in rows:
        b = r["branch"]
        if not b:
            continue
        rank = order.get(r["state"], 2)
        if b not in best or rank < best[b][2]:
            best[b] = (r["name"], r["state"], rank)
    return {b: (n, s) for b, (n, s, _) in best.items()}


def az_repo(org, proj, repo, *args):
    return sh(["az", "repos", *args, "--organization", f"https://dev.azure.com/{org}",
               "--project", proj, "--repository", repo])


def vote_summary(votes):
    if not votes:
        return "0 reviewers — parked"
    nums = [int(v) for v in votes if str(v).lstrip("-").isdigit()]
    if any(v == -10 for v in nums):
        return "rejected"
    if any(v == -5 for v in nums):
        return "changes requested"
    if any(v >= 5 for v in nums):
        return "approved"
    return "awaiting review"


def fetch_prs(cwd, rows):
    """Active PRs the current git user authored in this checkout's Azure repo,
    each joined to a session (by branch), work items, desc refs, and votes."""
    if not cwd or not os.path.isdir(cwd):
        return None, None, None
    ids = azure_ids(sh(["git", "-C", cwd, "remote", "get-url", "origin"]))
    if not ids:
        return None, None, None
    org, proj, repo = ids
    author = sh(["git", "-C", cwd, "config", "user.name"])
    raw = az_repo(org, proj, repo, "pr", "list", "--status", "active",
                  "--query", "[].{id:pullRequestId,by:createdBy.displayName,"
                  "branch:sourceRefName,draft:isDraft,title:title,created:creationDate}")
    try:
        prs = json.loads(raw or "[]")
    except json.JSONDecodeError:
        return None, None, None
    bmap = branch_session_map(rows)
    base = f"https://dev.azure.com/{org}/{proj}"
    out = []
    for p in prs:
        if author and author.lower() not in (p.get("by") or "").lower():
            continue
        pid = p["id"]
        branch = (p.get("branch") or "").replace("refs/heads/", "")
        wis = sh(["az", "repos", "pr", "work-item", "list", "--id", str(pid),
                  "--organization", f"https://dev.azure.com/{org}", "--query", "[].id", "-o", "tsv"]).split()
        desc = sh(["az", "repos", "pr", "show", "--id", str(pid),
                   "--organization", f"https://dev.azure.com/{org}", "--query", "description", "-o", "tsv"])
        drefs = sorted(set(re.findall(r"GH-\d+|ADR-\d{4}", desc)))
        votes = sh(["az", "repos", "pr", "show", "--id", str(pid),
                    "--organization", f"https://dev.azure.com/{org}",
                    "--query", "reviewers[?vote!=`0`].vote", "-o", "tsv"]).split()
        sess = bmap.get(branch)
        age = days_since(p.get("created"))
        status = vote_summary(votes)
        if age is not None:
            status += f" · {age}d"
        out.append({
            "id": pid, "branch": branch, "title": p.get("title") or "",
            "draft": p.get("draft"), "wis": wis, "drefs": drefs,
            "status": status, "stale": age is not None and age >= 7,
            "session": sess[0] if sess else "", "sstate": sess[1] if sess else "",
        })
    out.sort(key=lambda p: (p["draft"] or False, p["id"]))
    return out, f"{base}/_git/{repo}/pullrequest/", f"{base}/_workitems/edit/"


def prs_html(prs, pr_base, wi_base):
    if prs is None:
        return '<p class="warn">Could not read PRs (no Azure remote, or az not logged in).</p>'
    if not prs:
        return '<p class="dim">No active PRs you authored.</p>'
    trs = []
    for p in prs:
        tick = " ".join(
            [link(wi_base, w, w) for w in p["wis"]] +
            [html.escape(d) for d in p["drefs"]]
        ) or "—"
        sess = f'{html.escape(p["session"])} <span class="dim">({html.escape(p["sstate"])})</span>' if p["session"] else '<span class="dim">— no live session</span>'
        trs.append(f'''<tr>
  <td>{link(pr_base, p["id"], "PR " + str(p["id"]))}{' <span class="dim">draft</span>' if p["draft"] else ''}</td>
  <td class="dim">{html.escape(p["branch"])}</td>
  <td>{tick}</td>
  <td>{sess}</td>
  <td class="{'warn' if p.get('stale') else ''}">{html.escape(p["status"])}</td>
  <td>{html.escape(p["title"][:60])}</td>
</tr>''')
    return f'''<h2>Your active PRs ({len(prs)})</h2>
<table><thead><tr><th>PR</th><th>Branch</th><th>Ticket</th><th>Session</th><th>Status</th><th>Title</th></tr></thead>
<tbody>{''.join(trs)}</tbody></table>'''


def summarise(rows, prs):
    """One batched `claude -p --model sonnet` call: a triage line + a
    'done → next' per session. Returns (triage_str, {sid8: summary}).
    Degrades to (None, {}) if the call or the parse fails."""
    lines = []
    for r in rows:
        dig = " ".join(x for x in [r["point"], r["last_asst"]] if x)[:400]
        lines.append(f'{r["sid"][:8]} | {r["name"]} | state={r["state"]} | {dig}')
    prtxt = ""
    if prs:
        prtxt = "\nOpen PRs (all parked, 0 reviewers): " + "; ".join(
            f'{p["id"]} {p["branch"]}' for p in prs)
    prompt = (
        "Triage these Claude Code sessions. Output ONLY a JSON object — no prose, "
        "no markdown fences:\n"
        '{"triage":"2-3 sentences, what to do now, most urgent first",'
        '"sessions":{"<id>":"<what is done> -> <what is next>, max 120 chars"}}\n'
        "Use the 8-char id shown at the start of each line.\n\nSessions:\n"
        + "\n".join(lines) + prtxt
    )
    try:
        r = subprocess.run(
            ["claude", "-p", "--model", "sonnet", prompt],
            capture_output=True, text=True, timeout=180,
            cwd=os.path.expanduser("~"),  # neutral dir — avoid a work repo's hooks
        )
        out = r.stdout
    except (subprocess.SubprocessError, OSError):
        return None, {}
    i, j = out.find("{"), out.rfind("}")
    if i < 0 or j <= i:
        return None, {}
    try:
        data = json.loads(out[i:j + 1])
    except json.JSONDecodeError:
        return None, {}
    return data.get("triage") or None, data.get("sessions") or {}


def link(base, ident, label):
    if base:
        return f'<a href="{html.escape(base)}{ident}" target="_blank">{label}</a>'
    return label


def refs_html(r):
    parts = []
    for pr in r["refs"]["prs"]:
        parts.append(link(r["pr_base"], pr, f"PR {pr}"))
    for wi in r["refs"]["wis"]:
        parts.append(link(r["wi_base"], wi, wi))
    for iss in r["refs"]["issues"]:
        base = f"https://github.com/{GH_REPO}/issues/" if GH_REPO else ""
        parts.append(link(base, iss, f"#{iss}"))
    return " ".join(parts) or "—"


def logged_html(r):
    lg = r["logged"]
    if lg["status"] == "logged":
        return f'<span class="ok">✓</span> {html.escape(lg["title"][:40])}'
    if lg["status"] == "missing" and r["sec"] in (2, 3):
        return '<span class="warn">⚠ not logged</span>'
    if lg["status"] == "ambiguous":
        return '<span class="dim">? main-checkout</span>'
    return "—"


def git_pill(r):
    bits = []
    if r["dirty"]:
        bits.append(f'{r["dirty"]}d')
    if r["unpushed"]:
        bits.append(f'↑{r["unpushed"]}')
    return f' <span class="pill">{" ".join(bits)}</span>' if bits else ""


def logged_pill(r):
    st = r["logged"]["status"]
    if st == "logged":
        return '<span class="ok">✓ logged</span>'
    if st == "missing":
        return '<span class="warn">⚠ not logged</span>'
    return ""


def git_html(r):
    if r["gone"]:
        return '<span class="warn">gone</span>'
    if not r["dirty"] and not r["unpushed"]:
        return '<span class="dim">clean</span>'
    bits = []
    if r["dirty"]:
        bits.append(f'<span class="warn">{r["dirty"]}d</span>')
    if r["unpushed"]:
        bits.append(f'<span class="warn">↑{r["unpushed"]}</span>')
    return " ".join(bits)


def render(rows, pr_section="", summaries=None, triage="", conflict_rows=None):
    """Reckoning layout — close-out buckets, not a dashboard. You dismiss, not watch."""
    summaries = summaries or {}

    def headline(r):
        # Prefer the authored SESSION_LOG summary/Next for closed sessions over
        # the transcript-tail heuristic; live sessions have no log entry yet.
        if r["state"] not in ("blocked", "working"):
            lg = r["logged"].get("summary")
            if lg:
                return lg
        return summaries.get(r["sid"][:8]) or r["point"] or "—"

    needs = sorted((r for r in rows if r["state"] in ("blocked", "working")),
                   key=lambda r: r["state"] != "blocked")
    dead = [r for r in rows if r["sec"] == 4]
    ids = {id(r) for r in needs} | {id(r) for r in dead}
    done = [r for r in rows if id(r) not in ids]
    done_unsaved = [r for r in done if r["dirty"] or r["unpushed"]]
    done_clean = [r for r in done if not (r["dirty"] or r["unpushed"])]
    clean_safe = [r for r in done_clean if r["logged"]["status"] == "logged"]
    clean_trap = [r for r in done_clean if r["logged"]["status"] != "logged"]

    def item(r, extra=""):
        rc = headline(r)
        rc = rc[:110] + "…" if len(rc) > 110 else rc
        rc = f'<span class="dim"> — {html.escape(rc)}</span>' if rc and rc != "—" else ""
        br = f'<span class="dim"> · {html.escape(r["branch"])}</span>' if r["branch"] else ""
        return f'<div class="it">{html.escape(r["name"])}{br}{rc}{extra}</div>'

    def bucket(title, cls, items, note=""):
        if not items:
            return ""
        note = f'<div class="note">{note}</div>' if note else ""
        return f'<section class="{cls}"><h2>{title} <span class="ct">{len(items)}</span></h2>{note}{"".join(items)}</section>'

    body = ""
    body += bucket("🔴 Needs you", "b-need",
                   [item(r, f' <span class="st st-{r["state"]}">{r["state"]}</span>'
                            f'{git_pill(r)}') for r in needs])
    body += bucket("🟠 Done · unsaved — review, then close", "b-unsaved",
                   [item(r, f'{git_pill(r)} {logged_pill(r)}') for r in done_unsaved],
                   "Uncommitted or unpushed work — look before you rm.")
    if clean_safe:
        cmds = "\n".join(f"claude rm {r['sid']}" for r in clean_safe)
        body += bucket("🟢 Done · clean · logged — safe to close", "b-safe",
                       [item(r, f' <code>claude rm {r["sid"][:8]}</code>') for r in clean_safe],
                       f'<button class="copy" data-cmds="{html.escape(cmds)}">copy all {len(clean_safe)} rm commands</button>')
    body += bucket("⚠ Done · clean · NOT logged — capture first", "b-trap",
                   [item(r) for r in clean_trap],
                   "No SESSION_LOG entry — the info lives only in the transcript. Resume + /close before rm.")
    body += bucket("💀 Dead / stale — registry ghosts", "b-dead",
                   [item(r, f' <code>claude rm {r["sid"][:8]}</code>' if r["sid"] else '') for r in dead])

    banner = f'<div class="triage">{html.escape(triage)}</div>' if triage else ""
    conflict = ""
    for br, names in (conflict_rows or []):
        conflict += (f'<div class="conflict">⚠ Conflict risk: {len(names)} live sessions share '
                     f'<b>{html.escape(br)}</b> with unsaved work — {html.escape(", ".join(names))}. '
                     f'Drive from one only.</div>')
    now = datetime.now().strftime("%Y-%m-%d %H:%M")
    open_ct = len(needs) + len(done_unsaved) + len(clean_trap)
    return f'''<!doctype html><html><head><meta charset="utf-8">
<title>Reckoning</title><style>
:root{{color-scheme:light dark}}
body{{font:14px system-ui,sans-serif;margin:0;padding:16px 16px 40px;background:#fafafa;color:#1a1a1a}}
@media(prefers-color-scheme:dark){{body{{background:#161616;color:#e6e6e6}}}}
h1{{font-size:18px;margin:0 0 4px}} .meta{{color:#888;margin-bottom:12px}}
section{{margin:0 0 18px;max-width:720px}}
h2{{font-size:14px;margin:16px 0 4px;font-weight:600}} .ct{{color:#888;font-weight:400}}
.note{{color:#888;font-size:12px;margin:0 0 6px}}
.it{{padding:4px 8px;border-bottom:1px solid #e2e2e2;font-weight:600}}
@media(prefers-color-scheme:dark){{.it{{border-color:#2a2a2a}}}}
.dim{{color:#888;font-weight:400}}
.st{{font-size:11px;font-weight:700;padding:0 5px;border-radius:3px}}
.st-blocked{{background:#c0392b;color:#fff}} .st-working{{background:#b8860b;color:#fff}}
.pill{{font-size:11px;color:#c0392b;font-weight:700;margin-left:4px}}
.ok{{color:#2c7;font-weight:700;font-size:11px;margin-left:4px}}
.warn{{color:#c0392b;font-weight:700;font-size:11px;margin-left:4px}}
code{{background:#0001;padding:1px 5px;border-radius:4px;font-size:12px;font-weight:400}}
@media(prefers-color-scheme:dark){{code{{background:#fff1}}}}
.triage{{background:#eef3ff;border-left:3px solid #3060c0;padding:10px 12px;border-radius:6px;margin-bottom:12px;line-height:1.4}}
.conflict{{background:#fff0ee;border-left:3px solid #c0392b;padding:10px 12px;border-radius:6px;margin-bottom:8px;line-height:1.4}}
@media(prefers-color-scheme:dark){{.triage{{background:#16233f}} .conflict{{background:#3a1c18}}}}
.b-need h2{{color:#c0392b}}
button.copy{{font:12px system-ui;padding:3px 10px;border:1px solid #2c7;border-radius:12px;background:transparent;color:#2c7;cursor:pointer;margin:4px 0 8px}}
button.copy.done{{background:#2c7;color:#fff}}
a{{color:#3a7bd5}} h2 a{{font-size:12px}}
</style></head><body>
<h1>Reckoning <span class="dim" style="font-size:13px;font-weight:400">— {open_ct} still open, {len(clean_safe)} ready to close</span></h1>
<div class="meta">{len(rows)} sessions · {html.escape(now)} · read-only</div>
{conflict}
{banner}
{pr_section}
{body}
<script>
document.querySelectorAll('button.copy').forEach(b=>b.onclick=async()=>{{
 try{{await navigator.clipboard.writeText(b.dataset.cmds);b.textContent='✓ copied — paste in a terminal';b.classList.add('done');}}
 catch(e){{b.textContent='copy failed — select manually';}}}});
</script></body></html>'''


def pick_azure_cwd(rows):
    seen = set()
    for r in rows:
        c = r["cwd"]
        if not c or c in seen or not os.path.isdir(c):
            continue
        seen.add(c)
        if azure_ids(sh(["git", "-C", c, "remote", "get-url", "origin"])):
            return c
    return None


def main():
    args = sys.argv[1:]
    rows = gather()
    prs = pr_base = wi_base = None
    if "--prs" in args or "--summarise" in args:
        prs, pr_base, wi_base = fetch_prs(pick_azure_cwd(rows), rows)
    pr_section = prs_html(prs, pr_base, wi_base) if "--prs" in args else ""
    summaries = triage = None
    if "--summarise" in args:
        triage, summaries = summarise(rows, prs)
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    with open(OUT, "w", encoding="utf-8") as f:
        f.write(render(rows, pr_section, summaries, triage or "", conflicts(rows)))
    write_status(rows, prs)
    print(OUT)


def write_status(rows, prs):
    """A one-line summary for a statusline to cat (~/.cache/claude/board-status.txt)."""
    nb = sum(1 for r in rows if r["state"] == "blocked")
    nw = sum(1 for r in rows if r["state"] == "working")
    nd = sum(1 for r in rows if r["dirty"] or r["unpushed"])
    parts = [f"{nb} blocked", f"{nw} working", f"{nd} dirty"]
    if prs:
        parts.append(f"{len(prs)} PRs")
    urgent = next((r["name"] for r in rows if r["state"] == "blocked"), None) \
        or next((r["name"] for r in rows if r["dirty"] or r["unpushed"]), None)
    if urgent:
        parts.append(f"▶ {urgent}")
    with open(os.path.join(os.path.dirname(OUT), "board-status.txt"), "w", encoding="utf-8") as f:
        f.write(" · ".join(parts) + "\n")
    if "--no-open" not in sys.argv[1:]:
        for opener in ("wslview", "xdg-open"):
            if shutil.which(opener):
                subprocess.Popen([opener, OUT], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break


if __name__ == "__main__":
    main()
