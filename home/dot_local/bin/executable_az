#!/usr/bin/env bash
# az shim for work WSL2. The managed Windows device passes Conditional Access and the
# WSL Azure CLI does not. When WSL az has no session, WSL az runs the command with a token
# from the Windows side: Git Credential Manager for Azure DevOps, Windows az for the rest.
#   AZ_SHIM=wsl|windows  force a side.   az --shim-self-test  run the checks.
# gap: `az login --use-device-code` from WSL fails Conditional Access, and az has no
# option to borrow the Windows CLI's session.
# shortcut: cache-file detection says "a session exists", not "it is still valid";
# an expired WSL session fails like plain az would, force AZ_SHIM=windows then.
# shortcut: the token reaches WSL az through argv or the environment, so the same user can
# read it in ps or /proc for the length of the call; az rest and the devops extension take
# no other form. Key Vault commands cannot take a token, so keyvault is the one full forward.
# shortcut: tokens are reused from 0600 files in TOKEN_DIR until 5 minutes before expiry; a
# token revoked early keeps failing until then, `rm -r "$TOKEN_DIR"` clears it.
REAL_AZ=/usr/bin/az
WIN_PY="/mnt/c/Program Files/Microsoft SDKs/Azure/CLI2/python.exe"
# python.exe directly, not az.cmd: no cmd.exe, so no %, ^, & or quote rewriting, and
# WSL interop quotes argv for CreateProcess. -X utf8 keeps non-ASCII output intact under -I.
WIN_CMD=("$WIN_PY" -X utf8 -IBm azure.cli)
ADO_RESOURCE=499b84ac-1321-427f-aa17-267ca6975798 # Azure DevOps' public AAD resource id
TOKEN_DIR=${XDG_RUNTIME_DIR:-$HOME/.cache}/az-shim
# called directly, not via git: git's chain ends in ~/.git-azdo-helper.sh, which calls az.
# Same path as credential.helper in dot_config/git/config.tmpl; move both together.
GCM="/mnt/c/Program Files/Git/ucrt64/bin/git-credential-manager.exe"
GCM_TIMEOUT=10 # seconds; a GCM that would show a sign-in window is killed and Windows az used

# Is there a usable WSL session? Cheap file reads, no network.
has_session() {
  local d=${AZURE_CONFIG_DIR:-$HOME/.azure}
  grep -qs '"user"' "$d/azureProfile.json" && return 0
  cat "$d/msal_token_cache.json" 2>/dev/null | tr -d ' \n\t\r' | grep -Eq '"(RefreshToken|Account)":\{"' && return 0
  grep -Eqs '"(client_id|servicePrincipalId)"' "$d/service_principal_entries.json" 2>/dev/null
}

# How does this call run? $@ are az's args. wsl | windows (whole command) | pat | rest.
route() {
  case $1 in login | logout) echo wsl; return ;; esac # sign-in always happens in WSL
  case ${AZ_SHIM:-} in wsl | windows) echo "$AZ_SHIM"; return ;; esac
  has_session && { echo wsl; return; }
  case $1 in
    account) case ${2:-} in get-access-token | show) echo windows ;; *) echo wsl ;; esac ;;
    repos | boards | pipelines | devops | artifacts) echo pat ;;
    rest) echo rest ;;
    keyvault) echo windows ;;
    *) echo wsl ;;
  esac
}

# Windows cwd: cmd-hosted programs reject a UNC cwd.
win_home() {
  local h
  h=$(cd /mnt/c && /mnt/c/Windows/System32/cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')
  h=$(wslpath "$h" 2>/dev/null) && [[ -d $h ]] || h=/mnt/c/Windows/System32
  printf '%s' "$h"
}

# Run "${WIN_CMD[@]}" "$@" from the Windows profile dir; stdout loses \r; stderr and exit code pass.
run_windows() {
  (cd "$(win_home)" && "${WIN_CMD[@]}" "$@") | tr -d '\r'
  return "${PIPESTATUS[0]}"
}

# Prints the org in Azure DevOps URL $1; empty for any other URL.
url_org() {
  local v=$1
  case $v in
    https://dev.azure.com/*) v=${v#https://dev.azure.com/} v=${v%%[/?]*} ;;
    https://*.visualstudio.com*) v=${v#https://} v=${v%%.*} ;;
    *) v= ;;
  esac
  printf '%s' "$v"
}

# Prints the Azure DevOps org for az args $@: the URL in --org or --organization, else
# `az devops configure`'s default.
ado_org() {
  local a prev= v=
  for a in "$@"; do
    case $prev in --org | --organization) v=$a ;; esac
    case $a in --org=* | --organization=*) v=${a#*=} ;; esac
    prev=$a
  done
  [[ -n $v ]] || v=$(sed -n 's/^organization *= *//p' "${AZURE_CONFIG_DIR:-$HOME/.azure}/azuredevops/config" 2>/dev/null | head -1)
  url_org "$v"
}

# Sets REPLY to an Azure DevOps token for org $1 from Git Credential Manager, which signs in
# through the Windows broker and renews its own tokens. A Windows program sees only the
# variables WSLENV names, so the no-prompt and OAuth settings go through it. Never prompts.
gcm_token() {
  [[ -n $1 && -x $GCM ]] || return 1
  REPLY=$(printf 'protocol=https\nhost=dev.azure.com\npath=%s\n\n' "$1" \
    | WSLENV=${WSLENV:+$WSLENV:}GCM_INTERACTIVE:GCM_AZREPOS_CREDENTIALTYPE \
      GCM_INTERACTIVE=never GCM_AZREPOS_CREDENTIALTYPE=oauth timeout "$GCM_TIMEOUT" "$GCM" get 2>/dev/null \
    | tr -d '\r' | sed -n 's/^password=//p')
  [[ -n $REPLY ]]
}

# Prints the exp claim of JWT $1; fails when it is not a JWT.
jwt_exp() {
  [[ $1 == *.*.* ]] || return 1
  local p=${1#*.}
  p=${p%%.*} p=${p//-/+} p=${p//_//}
  while ((${#p} % 4)); do p+='='; done
  [[ $(base64 -d <<<"$p" 2>/dev/null) =~ \"exp\":\ *([0-9]+) ]] && printf '%s' "${BASH_REMATCH[1]}"
}

# Sets REPLY to a token for resource $1, and Azure DevOps org $2 when known; cached per
# resource and org. GCM mints Azure DevOps tokens; Windows az mints the rest, or when GCM fails.
mint_token() {
  local res=$1 org=${2:-} f exp tok out
  f=$TOKEN_DIR/$(printf '%s|%s' "$res" "$org" | md5sum | cut -c1-16)
  if { read -r exp && read -r tok; } 2>/dev/null <"$f" && [[ $exp =~ ^[0-9]+$ && -n $tok ]] \
    && ((exp - 300 > $(date +%s))); then
    REPLY=$tok
    return
  fi
  if [[ $res == "$ADO_RESOURCE" ]] && gcm_token "$org"; then
    tok=$REPLY
    exp=$(jwt_exp "$tok") || exp=$(($(date +%s) + 3000)) # a PAT has no expiry to read: recheck in 50 min
  else
    [[ -x ${WIN_CMD[0]} ]] || { echo "az shim: no token for $res: GCM failed and Windows az not found at ${WIN_CMD[0]}" >&2; return 1; }
    out=$(run_windows account get-access-token --resource "$res" --query '[accessToken, expires_on]' -o tsv) || return
    { read -r tok; read -r exp; } <<<"$out"
    [[ -n $tok ]] || { echo "az shim: Windows az returned no token for $res" >&2; return 1; }
  fi
  if [[ $exp =~ ^[0-9]+$ ]]; then
    (umask 077 && mkdir -p "$TOKEN_DIR" && printf '%s\n%s\n' "$exp" "$tok" >"$f.$$" && mv -f "$f.$$" "$f") 2>/dev/null
  fi
  REPLY=$tok
}

# The AAD resource for a URI's host; empty when unknown.
resource_for() {
  local h=${1#*://}
  h=${h%%[/?]*}
  case ${h%%:*} in
    dev.azure.com | *.visualstudio.com) echo "$ADO_RESOURCE" ;;
    *.vault.azure.net) echo https://vault.azure.net ;;
    management.azure.com) echo https://management.azure.com ;;
  esac
}

# Splits az rest's args: REST_RES is the --resource (else the URI host's), REST_KEEP the rest.
parse_rest() {
  local a uri= prev= skip=0
  REST_RES= REST_URI=
  REST_KEEP=()
  for a in "$@"; do
    if ((skip)); then REST_RES=$a skip=0; continue; fi
    case $a in
      --resource) skip=1; continue ;;
      --resource=*) REST_RES=${a#*=}; continue ;;
      --uri=* | --url=*) uri=${a#*=} ;;
    esac
    [[ $prev == --uri || $prev == --url || $prev == -u ]] && uri=$a
    prev=$a
    REST_KEEP+=("$a")
  done
  REST_URI=$uri
  [[ -n $REST_RES ]] || REST_RES=$(resource_for "$uri")
}

# Sets AUTH_ARGS to az rest's args $2.. with $1 as the bearer token. --headers takes a list and
# a second --headers replaces the first, so the header joins the caller's own list.
add_auth() {
  local t=$1 a added=0
  shift
  AUTH_ARGS=()
  for a in "$@"; do
    case $a in
      --headers) AUTH_ARGS+=("$a" "Authorization=Bearer $t"); added=1 ;;
      --headers=*) AUTH_ARGS+=(--headers "Authorization=Bearer $t" "${a#*=}"); added=1 ;;
      *) AUTH_ARGS+=("$a") ;;
    esac
  done
  ((added)) || AUTH_ARGS+=(--headers "Authorization=Bearer $t")
  AUTH_ARGS+=(--skip-authorization-header)
}

# Replaces the process (exec) or exits; call it in a subshell to test it.
dispatch() {
  local side
  side=$(route "$@")
  case $side in
    windows)
      if [[ ! -x ${WIN_CMD[0]} ]]; then
        echo "az shim: Windows az not found at ${WIN_CMD[0]}, running WSL az" >&2
        exec "$REAL_AZ" "$@"
      fi
      run_windows "$@"; exit $? ;;
    pat)
      [[ -n ${AZURE_DEVOPS_EXT_PAT:-} ]] && exec "$REAL_AZ" "$@" # a PAT already set wins
      mint_token "$ADO_RESOURCE" "$(ado_org "$@")" || exit 1
      AZURE_DEVOPS_EXT_PAT=$REPLY exec "$REAL_AZ" "$@" ;;
    rest)
      parse_rest "$@"
      [[ -n $REST_RES ]] || exec "$REAL_AZ" "$@" # unknown host: fails as plain az would
      mint_token "$REST_RES" "$(url_org "$REST_URI")" || exit 1
      add_auth "$REPLY" "${REST_KEEP[@]}"
      exec "$REAL_AZ" "${AUTH_ARGS[@]}" ;;
    *) exec "$REAL_AZ" "$@" ;;
  esac
}

self_test() {
  local fails=0 t
  ok() { if [[ $2 == "$3" ]]; then echo "ok   $1"; else echo "FAIL $1: got [$2] want [$3]"; fails=$((fails + 1)); fi; }

  # session detection
  t=$(mktemp -d)
  mkdir "$t/empty" "$t/prof" "$t/rt" "$t/sp"
  printf '\xef\xbb\xbf{"subscriptions": []}' >"$t/empty/azureProfile.json"
  printf '{\n "RefreshToken": {},\n "Account": {}\n}' >"$t/empty/msal_token_cache.json"
  printf '{"subscriptions": [{"id": "x", "user": {"name": "n"}}]}' >"$t/prof/azureProfile.json"
  printf '{\n "RefreshToken": {\n  "k": {"v": 1}\n }\n}' >"$t/rt/msal_token_cache.json"
  printf '[{"client_id": "c"}]' >"$t/sp/service_principal_entries.json"
  ok "no session: empty profile and cache" "$(AZURE_CONFIG_DIR=$t/empty has_session && echo y || echo n)" n
  ok "no session: missing dir" "$(AZURE_CONFIG_DIR=$t/none has_session && echo y || echo n)" n
  ok "session: subscription in profile" "$(AZURE_CONFIG_DIR=$t/prof has_session && echo y || echo n)" y
  ok "session: refresh token in msal cache" "$(AZURE_CONFIG_DIR=$t/rt has_session && echo y || echo n)" y
  ok "session: service principal" "$(AZURE_CONFIG_DIR=$t/sp has_session && echo y || echo n)" y

  # side choice
  local out=$t/empty in=$t/rt c
  ok "login stays WSL when signed out" "$(AZURE_CONFIG_DIR=$out route login)" wsl
  ok "login stays WSL under AZ_SHIM=windows" "$(AZ_SHIM=windows route login)" wsl
  ok "signed in -> wsl" "$(AZURE_CONFIG_DIR=$in route repos list)" wsl
  ok "AZ_SHIM forces windows" "$(AZURE_CONFIG_DIR=$in AZ_SHIM=windows route repos list)" windows
  ok "AZ_SHIM forces wsl" "$(AZURE_CONFIG_DIR=$out AZ_SHIM=wsl route repos list)" wsl
  ok "signed out: get-access-token -> windows" "$(AZURE_CONFIG_DIR=$out route account get-access-token)" windows
  ok "signed out: account show -> windows" "$(AZURE_CONFIG_DIR=$out route account show)" windows
  ok "signed out: account list -> wsl" "$(AZURE_CONFIG_DIR=$out route account list)" wsl
  for c in repos boards pipelines devops artifacts; do
    ok "signed out: $c -> pat" "$(AZURE_CONFIG_DIR=$out route $c x)" pat
  done
  ok "signed out: rest -> rest" "$(AZURE_CONFIG_DIR=$out route rest)" rest
  ok "signed out: keyvault -> windows" "$(AZURE_CONFIG_DIR=$out route keyvault secret show)" windows
  ok "signed out: extension stays wsl" "$(AZURE_CONFIG_DIR=$out route extension list)" wsl
  ok "signed out: anything else stays wsl" "$(AZURE_CONFIG_DIR=$out route vm list)" wsl

  # az rest: resource choice and arg rewriting
  ok "resource: dev.azure.com" "$(resource_for https://dev.azure.com/o/p/_apis/x)" "$ADO_RESOURCE"
  ok "resource: visualstudio.com" "$(resource_for 'https://o.vsrm.visualstudio.com?a=1')" "$ADO_RESOURCE"
  ok "resource: vault" "$(resource_for https://v.vault.azure.net:443/secrets)" https://vault.azure.net
  ok "resource: management" "$(resource_for https://management.azure.com/subscriptions)" https://management.azure.com
  ok "resource: unknown host" "$(resource_for https://example.com/x)" ""
  parse_rest rest --method get --uri https://dev.azure.com/o/_apis/x --query v
  ok "rest: resource from URI" "$REST_RES" "$ADO_RESOURCE"
  parse_rest rest --resource R1 --uri https://dev.azure.com/o --method get
  ok "rest: --resource wins, removed from args" "$REST_RES|${REST_KEEP[*]}" "R1|rest --uri https://dev.azure.com/o --method get"
  parse_rest rest --resource=R2 -u https://example.com
  ok "rest: --resource=R removed, -u read" "$REST_RES|${REST_KEEP[*]}" "R2|rest -u https://example.com"
  add_auth TOK rest --uri u
  ok "rest: headers added" "${AUTH_ARGS[*]}" "rest --uri u --headers Authorization=Bearer TOK --skip-authorization-header"
  add_auth TOK rest --headers A=1 B=2 --uri u
  ok "rest: existing headers kept" "${AUTH_ARGS[*]}" "rest --headers Authorization=Bearer TOK A=1 B=2 --uri u --skip-authorization-header"
  add_auth TOK rest --headers=A=1 --uri u
  ok "rest: --headers=A=1 kept" "${AUTH_ARGS[*]}" "rest --headers Authorization=Bearer TOK A=1 --uri u --skip-authorization-header"

  # Azure DevOps org and JWT expiry
  mkdir -p "$t/cfg/azuredevops"
  printf '[defaults]\norganization = https://dev.azure.com/dflt/\n' >"$t/cfg/azuredevops/config"
  mkjwt() { printf 'h.%s.s' "$(printf '%s' "$1" | base64 -w0 | tr -d =)"; }
  ok "org: --org URL" "$(ado_org repos list --org https://dev.azure.com/o1/)" o1
  ok "org: --organization= visualstudio.com" "$(ado_org repos list --organization=https://o2.visualstudio.com/)" o2
  ok "org: URL with a path and query" "$(ado_org --org 'https://dev.azure.com/o3/_apis/x?a=1')" o3
  ok "org: configured default" "$(AZURE_CONFIG_DIR=$t/cfg ado_org repos list)" dflt
  ok "org: none" "$(AZURE_CONFIG_DIR=$t/none ado_org repos list)" ""
  ok "org: not an Azure DevOps URL" "$(url_org https://v.vault.azure.net/secrets)" ""
  parse_rest rest --url=https://dev.azure.com/o3/_apis/x --method get
  ok "rest: URI kept for the org" "$REST_URI" https://dev.azure.com/o3/_apis/x
  ok "jwt: exp read" "$(jwt_exp "$(mkjwt '{"aud":"a","exp": 1234}')")" 1234
  ok "jwt: not a JWT" "$(jwt_exp abc && echo y || echo n)" n
  ok "jwt: URL-safe characters" "$(jwt_exp "h.$(printf '%s' '{"n":"~~~>>>???","exp":77}' | base64 -w0 | tr -d = | tr '+/' '-_').s")" 77

  # dispatch against a stub Windows az (prints TOK123, plus an expiry when asked for one, and
  # logs each mint to $MINTS; exit code STUB_RC) and a stub WSL az. The group runs in $( )
  # because dispatch execs; its FAIL lines are counted afterwards.
  printf '%s\n' '#!/usr/bin/env bash' \
    'if [[ "$1 $2" == "account get-access-token" ]]; then echo x >>"$MINTS"; printf "TOK123\r\n"' \
    '  [[ $* == *expires_on* ]] && printf "%s\r\n" "${STUB_EXP:-$(($(date +%s) + 3600))}"' \
    'else printf "WIN:%s\r\n" "$*"; fi' \
    'exit "${STUB_RC:-0}"' >"$t/win"
  printf '%s\n' '#!/usr/bin/env bash' \
    'printf "%s|" "${AZURE_DEVOPS_EXT_PAT:-}" "$@" >>"$REC"; exit 5' >"$t/real"
  # stub GCM: logs the request's path to $GCMLOG and its settings to $GCMENV; hangs for
  # $STUB_GCM_SLEEP s; prints $STUB_GCM_PW, or fails when unset
  printf '%s\n' '#!/usr/bin/env bash' \
    'sed -n "s/^path=//p" >>"$GCMLOG"' \
    'echo "$WSLENV|$GCM_INTERACTIVE|$GCM_AZREPOS_CREDENTIALTYPE" >"$GCMENV"' \
    'sleep "${STUB_GCM_SLEEP:-0}"' \
    '[[ -n ${STUB_GCM_PW:-} ]] || exit 1' \
    'printf "protocol=https\r\nusername=u\r\npassword=%s\r\n" "$STUB_GCM_PW"' >"$t/gcm"
  chmod +x "$t/win" "$t/real" "$t/gcm"
  local grp
  grp=$(
    REAL_AZ=$t/real WIN_CMD=("$t/win") AZURE_CONFIG_DIR=$out TOKEN_DIR=$t/tok GCM=$t/gcm
    export REC=$t/rec MINTS=$t/mints GCMLOG=$t/gcmlog GCMENV=$t/gcmenv
    unset STUB_GCM_PW
    mints() { cat "$MINTS" 2>/dev/null | wc -l | tr -d ' '; }
    fresh() { rm -rf "$TOKEN_DIR" "$MINTS" "$GCMLOG"; }
    state() { echo "$(mints)|$(paste -sd' ' "$GCMLOG" 2>/dev/null)|$(rec)"; } # Windows mints|GCM orgs|WSL az calls
    unset AZURE_DEVOPS_EXT_PAT AZ_SHIM
    rec() { cat "$REC"; : >"$REC"; }
    got=$(dispatch repos pr show --id 1 2>&1)
    rc=$?
    ok "pat: exit code passes through" "$rc" 5
    ok "pat: token in the environment, args unchanged" "$(rec)" "TOK123|repos|pr|show|--id|1|"
    ok "pat: token never echoed" "$got" ""
    got=$(dispatch rest --method get --resource R --uri https://dev.azure.com/o --headers A=1 2>&1)
    ok "rest: real az gets bearer header, no --resource" "$(rec)" "|rest|--method|get|--uri|https://dev.azure.com/o|--headers|Authorization=Bearer TOK123|A=1|--skip-authorization-header|"
    ok "rest: token never echoed" "$got" ""
    (dispatch rest --uri https://example.com)
    ok "rest: unknown host goes to plain az" "$(rec)" "|rest|--uri|https://example.com|"
    (AZURE_DEVOPS_EXT_PAT=mine dispatch repos list)
    ok "pat: a PAT already set is kept" "$(rec)" "mine|repos|list|"
    got=$(STUB_RC=7 dispatch keyvault secret show --name n 2>&1)
    rc=$?
    ok "keyvault: whole command to Windows, no CR" "$got" "WIN:keyvault secret show --name n"
    ok "keyvault: exit code passes through" "$rc" 7
    ok "get-access-token: output through Windows" "$(dispatch account get-access-token --resource R --query expiresOn -o tsv)" TOK123
    (AZURE_CONFIG_DIR=$in dispatch repos list)
    ok "signed in: plain WSL az, no token" "$(rec)" "|repos|list|"

    # token cache
    fresh
    (dispatch repos list); (dispatch boards query)
    ok "cache: second call reuses the token" "$(state)" "1||TOK123|repos|list|TOK123|boards|query|"
    ok "cache: file is owner-only" "$(stat -c %a "$TOKEN_DIR"/*)" 600
    fresh
    (STUB_EXP=$(($(date +%s) + 60)) dispatch repos list); (dispatch repos list)
    ok "cache: token near expiry is minted again" "$(mints)" 2
    rec >/dev/null

    # GCM for Azure DevOps tokens
    local jwt o1=https://dev.azure.com/o1
    jwt=$(mkjwt "{\"exp\":$(($(date +%s) + 3600))}")
    fresh
    (STUB_GCM_PW=$jwt dispatch repos list --org $o1); (dispatch repos list --org $o1)
    ok "gcm: token used, Windows az never asked, cached" "$(state)" "0|o1|$jwt|repos|list|--org|$o1|$jwt|repos|list|--org|$o1|"
    fresh
    (STUB_GCM_PW=$jwt dispatch rest --uri https://dev.azure.com/o3/_apis/x)
    ok "gcm: rest org from the URI" "$(state)" "0|o3||rest|--uri|https://dev.azure.com/o3/_apis/x|--headers|Authorization=Bearer $jwt|--skip-authorization-header|"
    fresh
    (STUB_GCM_PW=pat123 dispatch repos list --org $o1); (dispatch repos list --org $o1)
    ok "gcm: a PAT is cached too" "$(state)" "0|o1|pat123|repos|list|--org|$o1|pat123|repos|list|--org|$o1|"
    fresh
    (dispatch repos list --org $o1)
    ok "gcm fails: Windows az mints instead" "$(state)" "1|o1|TOK123|repos|list|--org|$o1|"
    fresh
    (STUB_GCM_PW=$jwt dispatch repos list)
    ok "gcm: no org known, never asked" "$(state)" "1||TOK123|repos|list|"
    fresh
    (WSLENV=X/u STUB_GCM_PW=$jwt dispatch repos list --org $o1)
    ok "gcm: no-prompt and OAuth settings passed through WSLENV" "$(cat "$GCMENV")" "X/u:GCM_INTERACTIVE:GCM_AZREPOS_CREDENTIALTYPE|never|oauth"
    rec >/dev/null
    fresh
    (STUB_GCM_PW=pat123 dispatch repos list --org $o1); (STUB_GCM_PW=pat456 dispatch repos list --org https://dev.azure.com/o2)
    ok "gcm: each org gets its own cached token" "$(state)" "0|o1 o2|pat123|repos|list|--org|$o1|pat456|repos|list|--org|https://dev.azure.com/o2|"
    fresh
    (GCM_TIMEOUT=1 STUB_GCM_SLEEP=3 STUB_GCM_PW=$jwt dispatch repos list --org $o1)
    ok "gcm: a hung GCM is killed, Windows az mints instead" "$(state)" "1|o1|TOK123|repos|list|--org|$o1|"
    fresh
    (WIN_CMD=("$t/nowin"); STUB_GCM_PW=$jwt dispatch repos list --org $o1)
    ok "no Windows az: GCM still serves Azure DevOps" "$(state)" "0|o1|$jwt|repos|list|--org|$o1|"
    fresh
    got=$(WIN_CMD=("$t/nowin"); dispatch repos list --org $o1 2>&1)
    rc=$?
    ok "no Windows az, GCM fails: clear error, exit 1" "$rc|${got%%:*}|$(rec)" "1|az shim|"
    (WIN_CMD=("$t/nowin"); dispatch keyvault secret show 2>/dev/null)
    ok "no Windows az: keyvault falls back to WSL az" "$(rec)" "|keyvault|secret|show|"
  )
  echo "$grp"
  fails=$((fails + $(grep -c '^FAIL' <<<"$grp")))

  # a real round trip through Windows az
  if [[ -x $WIN_PY ]]; then
    ok "real Windows az runs" "$(run_windows --version | grep -c '^azure-cli')" 1
    ok "real Windows az: stdout has no CR" "$(run_windows --version | grep -c $'\r')" 0
  else
    echo "skip real Windows round trip: no Windows python at $WIN_PY"
  fi
  rm -rf "$t"
  ((fails == 0)) && echo "all passed" || echo "$fails failed"
  return $((fails > 0))
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  [[ ${1:-} == --shim-self-test ]] && { self_test; exit; }
  dispatch "$@"
fi
