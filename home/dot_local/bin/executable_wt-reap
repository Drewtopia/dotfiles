#!/usr/bin/env bash
# wt-reap [--go] [--idle-min N] — remove local branches, and their worktrees, whose work is
# already in the trunk. Run from a checkout of an Azure Repos repo, after `git fetch`.
#
# Dry run by default; --go removes. A branch qualifies only when all of these hold:
#   - it is an ancestor of origin/<trunk>
#   - its tip came into the trunk by a merge, or a PR from it has completed. A tip on the
#     trunk's first-parent line has no commits of its own: new work nobody has started,
#     unless a completed PR says it was merged and then synced to the trunk.
#   - its worktree, if any, is clean
#   - every Claude session in its worktree has been idle for N minutes (default 30)
# Removal goes through `wt remove`, so pre-remove hooks run (attic salvage, Orca terminal
# close) and wt keeps a branch it cannot prove merged. Never forces.
# Prints one line per candidate: "removed", "would remove" or "skip", the branch, a reason.
set -uo pipefail

trunk="${WT_REAP_TRUNK:-develop}"
go=0 idle_min=30
while [ $# -gt 0 ]; do
  case "$1" in
    --go) go=1 ;;
    --idle-min) idle_min=${2:?--idle-min needs minutes}; shift ;;
    *) echo "usage: wt-reap [--go] [--idle-min N]" >&2; exit 2 ;;
  esac
  shift
done

current=$(git branch --show-current 2>/dev/null || true)
main_path=$(git worktree list --porcelain | sed -n '1s/^worktree //p')

declare -A wt_path
while IFS= read -r line; do
  case "$line" in
    "worktree "*) path=${line#worktree } ;;
    "branch refs/heads/"*) wt_path[${line#branch refs/heads/}]="$path" ;;
  esac
done < <(git worktree list --porcelain)

declare -A mainline
while IFS= read -r c; do mainline[$c]=1; done < <(git rev-list --first-parent "origin/$trunk")

# A session is busy unless Claude recorded it idle at least $idle_min minutes ago.
busy_session_in() {
  local dir=$1 pid cwd rec cutoff
  cutoff=$(( $(date +%s) * 1000 - idle_min * 60000 ))
  for pid in $(pgrep -x claude); do
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
    [ "$cwd" = "$dir" ] || [[ "$cwd" == "$dir"/* ]] || continue
    rec="$HOME/.claude/sessions/$pid.json"
    if ! jq -e --argjson cutoff "$cutoff" \
      '.status == "idle" and (.statusUpdatedAt // 0) <= $cutoff' "$rec" >/dev/null 2>&1; then
      echo "$pid"
      return
    fi
  done
  return 1
}

git for-each-ref --format='%(refname:short)' refs/heads | while IFS= read -r b; do
  [ "$b" = "$trunk" ] && continue
  git merge-base --is-ancestor "$b" "origin/$trunk" 2>/dev/null || continue
  p=${wt_path[$b]:-}
  if [ "$b" = "$current" ] || [ "$p" = "$main_path" ]; then
    echo "skip          $b  (this checkout)"; continue
  fi
  if [ -n "$p" ] && [ -n "$(git -C "$p" status --porcelain 2>/dev/null)" ]; then
    echo "skip          $b  (uncommitted changes in $p)"; continue
  fi
  if [ -n "${mainline[$(git rev-parse "$b")]:-}" ]; then
    done_prs=$(az repos pr list --source-branch "$b" --status completed --top 1 \
      --query 'length(@)' -o tsv 2>/dev/null)
    if [ "${done_prs:-0}" -lt 1 ]; then
      echo "skip          $b  (no commits of its own and no completed PR)"; continue
    fi
  fi
  if [ -n "$p" ] && pid=$(busy_session_in "$p"); then
    echo "skip          $b  (Claude session $pid active in the last ${idle_min}m)"; continue
  fi
  if [ "$go" -eq 1 ]; then
    if out=$(wt remove --yes --foreground "$b" 2>&1 </dev/null); then
      echo "removed       $b"
    else
      echo "skip          $b  (wt remove failed: $(tail -1 <<<"$out"))"
    fi
  else
    echo "would remove  $b"
  fi
done
