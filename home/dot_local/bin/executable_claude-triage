#!/usr/bin/env python3
"""claude-triage — which Claude Code sessions have unfinished work.

Groups sessions by their working directory (many sessions often share one
checkout) and reports each directory's git state, so "which do I go back to?"
becomes a short, ranked list instead of a wall of session cards.

  UNFINISHED = the worktree has uncommitted or unpushed changes -> return here
  clean      = work is committed and pushed -> safe to `claude rm`
  gone       = the worktree no longer exists on disk

Usage:
  claude-triage           # all working directories, unfinished first
  claude-triage --dirty   # only directories with unsaved work
"""
import json
import os
import subprocess
import sys
from collections import defaultdict

DIRTY_ONLY = "--dirty" in sys.argv[1:]


def sh(args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=12)
    except (subprocess.SubprocessError, OSError):
        return None


def git(cwd, *args):
    r = sh(["git", "-C", cwd, *args])
    return r.stdout.strip() if r and r.returncode == 0 else ""


def main():
    r = sh(["claude", "agents", "--json", "--all"])
    if r is None:
        sys.exit("claude-triage: `claude` not found on PATH")
    if r.returncode != 0:
        sys.exit(f"claude-triage: `claude agents` failed: {r.stderr.strip() or r.returncode}")

    by_cwd = defaultdict(list)
    for s in json.loads(r.stdout or "[]"):
        by_cwd[s.get("cwd") or "<none>"].append(s)

    groups = []
    for cwd, sessions in by_cwd.items():
        exists = cwd != "<none>" and os.path.isdir(cwd)
        branch = ""
        dirty = unpushed = 0
        if exists:
            branch = git(cwd, "branch", "--show-current")
            status = git(cwd, "status", "--porcelain")
            dirty = len([ln for ln in status.splitlines() if ln.strip()])
            count = git(cwd, "rev-list", "--count", "@{u}..HEAD")
            unpushed = int(count) if count.isdigit() else 0
        groups.append((cwd, branch, dirty, unpushed, exists, sessions))

    # unfinished first, then by amount of unsaved work
    groups.sort(key=lambda g: (0 if (g[2] or g[3]) else 1, -(g[2] + g[3])))

    def short(path):
        if not path or path == "<none>":
            return path
        parts = path.replace("\\", "/").rstrip("/").split("/")
        return "/".join(parts[-2:])

    shown = 0
    for cwd, branch, dirty, unpushed, exists, sessions in groups:
        unfinished = bool(dirty or unpushed)
        if DIRTY_ONLY and not unfinished:
            continue
        shown += 1
        tag = "UNFINISHED" if unfinished else ("gone" if not exists else "clean")
        print(
            f"[{tag}] {short(cwd)}  branch={branch or '-'}  "
            f"dirty={dirty} unpushed={unpushed}  sessions={len(sessions)}"
        )
        for s in sessions[:8]:
            print(
                f"      - {s.get('id') or '-':9} {s.get('state', '-'):8} "
                f"{(s.get('name', '') or '')[:44]}"
            )
        if len(sessions) > 8:
            print(f"      ... +{len(sessions) - 8} more")

    total_sessions = sum(len(g[5]) for g in groups)
    unfinished_dirs = sum(1 for g in groups if g[2] or g[3])
    print()
    if DIRTY_ONLY and shown == 0:
        print("No working directories with uncommitted or unpushed work.")
    print(
        f"{total_sessions} sessions across {len(groups)} working directories | "
        f"{unfinished_dirs} with unsaved work"
    )


if __name__ == "__main__":
    main()
