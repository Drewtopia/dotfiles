#!/usr/bin/env python3
"""claude-log-session <session-id> — append a one-line trace of a session to
~/.claude/memory/SESSION_TAILS.md (or $CLAUDE_SESSION_TAILS), idempotent per id,
so a session that ends without /close still leaves a record.
"""
import datetime
import os
import subprocess
import sys

LOG = os.environ.get("CLAUDE_SESSION_TAILS") or os.path.expanduser("~/.claude/memory/SESSION_TAILS.md")
HEADER = ("# Session tails\n\nAuto-captured when a session ends without /close. "
          "Curated closeouts live in SESSION_LOG.md.\n\n")


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: claude-log-session <session-id>")
    sid8 = sys.argv[1][:8]
    if os.path.isfile(LOG) and sid8 in open(LOG, encoding="utf-8").read():
        return  # already recorded — idempotent
    try:
        tail = subprocess.run(["claude-tail", sys.argv[1]], capture_output=True,
                              text=True, timeout=15).stdout
    except (subprocess.SubprocessError, OSError):
        return
    point = last = ""
    for line in tail.splitlines():
        if line.startswith("POINT: "):
            point = line[7:]
        elif line.startswith("LAST-ASSISTANT: "):
            last = line[16:]
    if not point and not last:
        return  # nothing worth recording
    entry = f"- {datetime.date.today().isoformat()} `{sid8}` — {point[:100]} → {last[:120]}\n"
    existed = os.path.isfile(LOG)
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as f:
        if not existed:
            f.write(HEADER)
        f.write(entry)


if __name__ == "__main__":
    main()
