#!/usr/bin/env python3
"""claude-ls — list Claude Code sessions with their ids.

Feed an id to `claude stop <id>` (running) or `claude rm <id>` (done/exited).
Rows with id `-` are interactive sessions (no card) — close those in their tab.
"""
import json
import subprocess
import sys
import time


def main():
    try:
        out = subprocess.run(
            ["claude", "agents", "--json", "--all"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    except FileNotFoundError:
        sys.exit("claude-ls: `claude` not found on PATH")
    except subprocess.CalledProcessError as e:
        sys.exit(f"claude-ls: `claude agents` failed: {e.stderr.strip() or e}")

    sessions = json.loads(out or "[]")
    now = time.time() * 1000

    def age(ms):
        h = (now - ms) / 3_600_000
        return f"{h:.1f}h" if h < 48 else f"{h / 24:.1f}d"

    rows = sorted(sessions, key=lambda s: s.get("startedAt", 0))
    print(f"{'id':10} {'state':8} {'status':6} {'pid':>6} {'age':>6}  name")
    for s in rows:
        print(
            f"{s.get('id', '-'):10} {s.get('state', '-'):8} "
            f"{str(s.get('status', '-')):6} {str(s.get('pid', '-')):>6} "
            f"{age(s.get('startedAt', now)):>6}  {(s.get('name', '') or '')[:44]}"
        )


if __name__ == "__main__":
    main()
