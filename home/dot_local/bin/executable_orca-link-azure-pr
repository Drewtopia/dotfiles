#!/bin/sh
# Links an Azure DevOps PR to an Orca worktree card: orca-link-azure-pr <worktree-path> <pr|null>.
# Why: Orca's sidebar looks up only GitHub PRs for a project whose remote identity is GitHub, as
# AutomatedTesting's is through its `upstream` issues remote, so its Azure PRs get no badge until
# linked. `worktree.set` takes the link but the CLI has no flag for it, so this calls that RPC
# through Orca's own runtime client, run by the Orca binary in Node mode.
set -eu

[ $# -eq 2 ] || { echo "usage: orca-link-azure-pr <worktree-path> <pr|null>" >&2; exit 2; }
case "$2" in
  null) ;;
  '' | 0* | *[!0-9]*) echo "orca-link-azure-pr: PR must be a number or null, got '$2'" >&2; exit 2 ;;
esac

APP=${ORCA_APP:-$HOME/.local/opt/orca/current/squashfs-root/orca-ide}
[ -x "$APP" ] || { echo "orca-link-azure-pr: no Orca app at $APP (set ORCA_APP)" >&2; exit 1; }

ORCA_ASAR="$(dirname "$APP")/resources/app.asar" WT=$1 PR=$2 ELECTRON_RUN_AS_NODE=1 "$APP" -e '
const { RuntimeClient } = require(process.env.ORCA_ASAR + "/out/cli/runtime-client.js");
const pr = process.env.PR === "null" ? null : Number(process.env.PR);
new RuntimeClient(undefined, undefined, null, null)
  .call("worktree.set", { worktree: "path:" + process.env.WT, linkedAzureDevOpsPR: pr })
  .then(() => process.exit(0), (e) => { console.error("orca-link-azure-pr: " + e.message); process.exit(1); });
'
