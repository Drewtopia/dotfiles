{{- /* WSL only. Installers may append lines after apply; the bail-early guard keeps
       non-interactive `bash -lc` silent whatever they add. */ -}}
case $- in
    *i*) ;;
      *) return;;
esac

[[ -f ~/.fzf.bash ]] && source ~/.fzf.bash
[[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh
[[ -f "${HOME}/.deno/env" ]] && . "${HOME}/.deno/env"
command -v atuin >/dev/null 2>&1 && eval "$(atuin init bash)"
[[ -d "${HOME}/.console-ninja/.bin" ]] && PATH="${HOME}/.console-ninja/.bin:${PATH}"

# `command wt`: bypass the wt shell function the integration defines.
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init bash)"; fi
