#!/bin/bash

set -eufo pipefail

echo "🍎 Installing system packages..."

# Third-party taps stay on brew bundle: mise needs Ruby 3 to evaluate tap
# definitions that publish no API metadata.
brew bundle --file=- <<EOF
tap "ognistik/formulae"
brew "ognistik/formulae/macrowhisper", trusted: true
tap "hamed-elfayome/claude-usage"
cask "hamed-elfayome/claude-usage/claude-usage-tracker", trusted: true
tap "nikitabobko/tap"
cask "nikitabobko/tap/aerospace", trusted: true
tap "stablyai/orca", trusted: true
cask "stablyai/orca/orca", trusted: true
EOF

# Everything else is declared in .chezmoitemplates/mise-bootstrap.toml. This
# script runs before chezmoi writes ~/.config/mise/conf.d/bootstrap.toml, so it
# applies an inline copy; the copy also retriggers run_onchange when the list changes.
# mise picks the parser from the extension, so the file must end in .toml.
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
config="$tmpdir/bootstrap.toml"
cat > "$config" <<'EOF'
{{ template "mise-bootstrap.toml" . }}
EOF
# before_00 may have just installed mise, possibly to ~/.local/bin, off this PATH.
mise_bin="$(command -v mise || echo "$HOME/.local/bin/mise")"
if ! "$mise_bin" bootstrap packages --help >/dev/null 2>&1; then
    echo "❌ $mise_bin has no 'bootstrap packages' (needs mise 2026.7.4+); run: brew upgrade mise" >&2
    exit 1
fi
MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" bootstrap packages apply --yes

echo "✅ System packages installed!"
