#!/bin/bash

set -eufo pipefail

{{ $brews := list
    "btop"
    "curl"
    "dockutil"
    "ffmpeg"
    "git"
    "git-lfs"
    "gnu-units"
    "gnupg"
    "kanata"
    "mas"
    "pkg-config"
    "shellcheck"
    "tmux"
    "wget"
    "xz" -}}
{{ $casks := list
	"1password@nightly"
    "1password-cli"
	"arc"
    "betterdisplay"
    "bruno"
    "chatgpt"
    "discord"
	"fmail3"
    "firefox@developer-edition"
    "font-fira-code"
    "font-fira-code-nerd-font"
    "font-fira-mono-nerd-font"
    "font-jetbrains-mono"
    "font-jetbrains-mono-nerd-font"
    "font-monaspace"
    "font-symbols-only-nerd-font"
    "ghostty"
    "git-credential-manager"
    "hammerspoon"
    "hazel"
    "home-assistant"
    "iina"
    "iterm2"
    "jdownloader"
    "jump-desktop-connect"
    "keka"
    "keyclu"
    "muzzle"
    "obsidian"
    "orion"
    "plex"
    "raindropio"
    "rectangle-pro"
    "setapp"
    "spotify"
    "soundsource"
    "glance-chamburr"
    "syntax-highlight"
    "tailscale-app"
    "telegram"
    "transmission"
    "unclack"
    "visual-studio-code"
    "wezterm"
    "zen"
    "qlmarkdown"
    "quicklook-video"
    "autodesk-fusion"
    "bambu-studio"
    "excalidrawz"
    "localsend"
    "navigator"
    "rcmd"
    "steam"
    "supasidebar" -}}
{{ $mas := list
    "Actions;1586435171"
    "CloudMounter;1130254674"
    "Dato;1470584107"
    "Day Progress;6450280202"
    "Fusion;6759285919"
    "Hyperduck;6444667067"
    "Just Press Record;1033342465"
    "Kagi Search;1622835804"
    "keymapp;6472865291"
    "Noir;1592917505"
    "Obsidian Web Clipper;6720708363"
    "Pandan;1569600264"
    "Parachute;6748614170"
    "Raycast Companion;6738274497"
    "Refined GitHub;1519867270"
    "Sink It;6449873635"
    "SponsorBlock;1573461917"
    "StopTheMadness Pro;6471380298"
    "uBlock Origin Lite;6745342698"
    "Xcode;497799835" -}}

echo "🍎 Installing system packages via Homebrew..."

brew bundle --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
{{ range ($mas | sortAlpha | uniq) -}}
{{ $m := splitList ";" . -}}
mas "{{ index $m 0 }}", id: {{ index $m 1 }}
{{ end -}}
EOF

# Remove quarantine flag from Quick Look plugins that need it
for cask in glance-chamburr qlmarkdown; do
    cask_dir="$(brew --caskroom)/$cask" 2>/dev/null
    if [[ -d "$cask_dir" ]]; then
        xattr -dr com.apple.quarantine "$cask_dir" 2>/dev/null || true
    fi
done

echo "✅ Homebrew packages installed!"
