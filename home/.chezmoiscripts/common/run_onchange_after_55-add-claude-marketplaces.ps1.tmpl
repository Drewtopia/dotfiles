{{- if and (eq .chezmoi.os "windows") (not .work) -}}
# Register the Claude Code plugin marketplaces declared in .chezmoidata/claude.toml
# that are not registered yet (Windows counterpart of the .sh sibling).
# `marketplace add` on a registered name replaces it, so those are skipped.
# topgrade's claude_code_plugins step refreshes registered marketplaces and
# updates installed plugins. See the .sh sibling for why a refreshed
# marketplace still leaves plugins pinned to their install commit.
#
# ASCII-only: chezmoi writes scripts as UTF-8 without BOM, and PowerShell
# defaults to CP1252 parsing on Windows, which mangles multi-byte chars.
#
# Inlining the desired marketplaces below makes run_onchange retrigger when
# claude.toml changes:
{{- range $name, $repo := .marketplaces }}
#   {{ $name }} -> {{ $repo }}
{{- end }}

$ErrorActionPreference = "Stop"

if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
    Write-Host 'i  claude CLI not on PATH; skipping marketplace sync'
    exit 0
}

$listJson = & claude plugin marketplace list --json
if ($LASTEXITCODE -ne 0) {
    Write-Host '[fail] claude plugin marketplace list --json failed' -ForegroundColor Red
    exit 1
}
$registered = @(($listJson | Out-String | ConvertFrom-Json) | ForEach-Object { $_.name })
$failed = 0

{{- range $name, $repo := .marketplaces }}
if ($registered -contains '{{ $name }}') {
    Write-Host '[skip] marketplace {{ $name }} already registered' -ForegroundColor DarkGray
} else {
    & claude plugin marketplace add {{ $repo }}
    if ($LASTEXITCODE -eq 0) {
        Write-Host '[ok]   marketplace {{ $name }} registered' -ForegroundColor Green
    } else {
        Write-Host '[fail] marketplace {{ $name }} ({{ $repo }}) failed to register' -ForegroundColor Red
        $failed = 1
    }
}
{{- end }}

exit $failed
{{- end -}}
