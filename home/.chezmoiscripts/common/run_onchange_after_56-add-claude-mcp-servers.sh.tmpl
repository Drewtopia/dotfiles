{{- $servers := includeTemplate "claude-mcp-servers" . | mustFromJson -}}
{{- if $servers -}}
#!/usr/bin/env bash
# Add the user-scope MCP servers .chezmoidata/claude.toml declares for this
# machine's profiles. Names already in .claude.json are left as is.
# servers-hash (retriggers run_onchange when the servers change): {{ $servers | mustToJson | sha256sum }}

set -euo pipefail

if ! command -v claude >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  echo "ℹ️  claude or jq not on PATH; skipping MCP server sync" >&2
  exit 0
fi

configured=$(jq -r '.mcpServers // {} | keys[]' "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" 2>/dev/null || true)

{{- range $name, $server := $servers }}
if grep -qxF '{{ $name }}' <<<"$configured"; then
  echo "  MCP server {{ $name }} already configured"
elif claude mcp add -s user '{{ $name }}'
{{- range $k, $v := get $server "env" | default dict }} -e '{{ printf "%s=%s" $k $v | replace "'" "'\\''" }}'{{ end }} -- '{{ $server.command | replace "'" "'\\''" }}'
{{- range $server.args }} '{{ . | replace "'" "'\\''" }}'{{ end }} >/dev/null; then
  echo "✓ MCP server {{ $name }} added"
else
  echo "⚠️  MCP server {{ $name }} failed to add, continuing" >&2
fi
{{- end }}
{{ end -}}
