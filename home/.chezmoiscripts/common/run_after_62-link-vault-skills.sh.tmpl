{{- if ne .chezmoi.os "windows" -}}
{{- if or .personal .work -}}
#!/usr/bin/env bash
# Links each skill in the claude-vault clone into ~/.claude/skills, the way
# symlink_rules.tmpl links its rules. ~/.claude/skills also holds chezmoi's own
# skills and the npx-installed ones, so it is linked per skill, not as a folder.
# run_after, not run_onchange: a vault pull adds skills without changing this
# source. A name already taken by anything else is left alone, and a link whose
# vault skill was deleted is removed.
# Work machines get every vault skill. Other machines get only the skills that
# carry a .personal marker file, since most vault skills drive work systems.
# A skill with a .requires file (one command per line) is linked only where
# every command is on PATH or in ~/.local/bin, on any machine.
vault="$HOME/.claude-vault/skills"
dir="$HOME/.claude/skills"
[ -d "$vault" ] || exit 0
mkdir -p "$dir"

has_requires() {
    local cmd
    [ -f "$1/.requires" ] || return 0
    while IFS= read -r cmd || [ -n "$cmd" ]; do
        cmd=${cmd%%#*}
        cmd=${cmd//[[:space:]]/}
        [ -n "$cmd" ] || continue
        command -v "$cmd" >/dev/null 2>&1 || [ -x "$HOME/.local/bin/$cmd" ] || return 1
    done < "$1/.requires"
}

for skill in "$vault"/*/; do
    skill=${skill%/}
    name=$(basename "$skill")
    [ -f "$skill/SKILL.md" ] || continue
{{- if not .work }}
    [ -f "$skill/.personal" ] || continue
{{- end }}
    has_requires "$skill" || continue
    link="$dir/$name"
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$skill" ]; then
        continue
    elif [ -e "$link" ] || [ -L "$link" ]; then
        echo "[vault-skills] $name: $link already exists, not linked"
    else
        ln -s "$skill" "$link" && echo "[vault-skills] linked $name"
    fi
done

for link in "$dir"/*; do
    [ -L "$link" ] || continue
    target=$(readlink "$link")
    case "$target" in "$vault"/*) ;; *) continue ;; esac
    if [ ! -e "$link" ]; then
        rm "$link" && echo "[vault-skills] unlinked $(basename "$link") (gone from the vault)"
{{- if not .work }}
    elif [ ! -f "$target/.personal" ]; then
        rm "$link" && echo "[vault-skills] unlinked $(basename "$link") (no .personal marker)"
{{- end }}
    elif ! has_requires "$target"; then
        rm "$link" && echo "[vault-skills] unlinked $(basename "$link") (a .requires command is missing)"
    fi
done
{{- end }}
{{- end }}
