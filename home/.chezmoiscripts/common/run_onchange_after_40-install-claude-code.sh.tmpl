{{- if .dev_computer -}}
#!/bin/bash

set -eufo pipefail

# Install Claude Code using the native installer (recommended approach)
# This script runs when the hash changes (onchange)

echo "Installing Claude Code using native installer..."

# Always run installation to ensure correct version and location
# This ensures chezmoi-managed installation takes precedence over external installations
echo "Ensuring Claude Code is installed/updated to ~/.local/bin/claude..."

# macOS, Linux, WSL installation
echo "Installing Claude Code for Unix-like systems..."
if ! curl -fsSL https://claude.ai/install.sh | bash; then
    echo "⚠️  Claude Code install failed; continuing the apply" >&2
    echo "⚠️  Retry with: curl -fsSL https://claude.ai/install.sh | bash" >&2
    exit 0
fi

# Ensure ~/.local/bin is in PATH for the current session
export PATH="$HOME/.local/bin:$PATH"

# Verify installation
if command -v claude >/dev/null 2>&1; then
    echo "Claude Code installed successfully: $(claude --version)"

    # Run claude doctor to check installation health
    echo "Running installation health check..."
    claude doctor || echo "Doctor check completed with warnings"
else
    echo "⚠️  Claude Code installed but not found in PATH; continuing the apply" >&2
    echo "⚠️  Please ensure ~/.local/bin is in your PATH" >&2
fi
{{ end -}}
