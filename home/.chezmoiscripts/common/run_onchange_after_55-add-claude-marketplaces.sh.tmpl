{{- if .dev_computer -}}
#!/usr/bin/env bash
# Register the Claude Code plugin marketplaces declared in .chezmoidata/claude.toml
# that are not registered yet. `marketplace add` on a registered name replaces it,
# so those are skipped. topgrade's claude_code_plugins step refreshes registered
# marketplaces (`claude plugin marketplace update`) and updates installed plugins.
#
# Refreshing a marketplace does not re-install its plugins. `claude plugin
# update` compares the version string alone, so a marketplace that edits
# plugin.json without bumping semver leaves you pinned to the commit you
# first installed. Forcing it needs `claude plugin uninstall` + `install`.
#
# Inlining the desired marketplaces below makes run_onchange retrigger when
# claude.toml changes:
{{- range $name, $repo := .marketplaces }}
#   {{ $name }} -> {{ $repo }}
{{- end }}

set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  echo "ℹ️  claude CLI not on PATH; skipping marketplace sync" >&2
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "⚠️  jq not on PATH; skipping marketplace sync" >&2
  exit 0
fi

if ! registered=$(claude plugin marketplace list --json | jq -r '.[].name'); then
  echo "⚠️  could not list registered marketplaces; skipping marketplace sync" >&2
  exit 0
fi

{{- range $name, $repo := .marketplaces }}
if grep -qxF '{{ $name }}' <<<"$registered"; then
  echo "  marketplace {{ $name }} already registered"
elif claude plugin marketplace add {{ $repo }}; then
  echo "✓ marketplace {{ $name }} registered"
else
  echo "⚠️  marketplace {{ $name }} ({{ $repo }}) failed to register, continuing" >&2
fi
{{- end }}
{{ end -}}
