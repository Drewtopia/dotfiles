#!/usr/bin/env bash
# Reconcile Claude Code plugin marketplaces against .chezmoidata/claude.toml.
# Registers each declared marketplace via `claude plugin marketplace add`,
# which also refreshes an already-registered one — so this script is the
# marketplace refresh path. topgrade's Claude Code step is NOT: it runs only
# `claude update` (the CLI self-updater) and never touches plugins.
#
# Refreshing a marketplace does not re-install its plugins. `claude plugin
# update` compares the version string alone, so a marketplace that edits
# plugin.json without bumping semver leaves you pinned to the commit you
# first installed. Forcing it needs `claude plugin uninstall` + `install`.
#
# Inlining the desired marketplaces below makes run_onchange retrigger when
# claude.toml changes:
{{- range $name, $repo := .marketplaces }}
#   {{ $name }} -> {{ $repo }}
{{- end }}

set -euo pipefail

if ! command -v claude >/dev/null 2>&1; then
  echo "ℹ️  claude CLI not on PATH; skipping marketplace sync" >&2
  exit 0
fi

{{- range $name, $repo := .marketplaces }}
output=$(claude plugin marketplace add {{ $repo }} 2>&1) && \
  echo "✓ marketplace {{ $name }} registered" || \
  echo "  marketplace {{ $name }} already registered (or add failed: ${output})"
{{- end }}
