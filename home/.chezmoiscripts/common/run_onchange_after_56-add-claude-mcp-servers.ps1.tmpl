{{- $active := dict "always" true "personal" .personal "work" .work "dev_computer" .dev_computer -}}
{{- $servers := dict -}}
{{- range $profile, $set := .mcp_servers -}}
{{-   if get $active $profile -}}
{{-     range $name, $server := $set }}{{ $_ := set $servers $name $server }}{{ end -}}
{{-   end -}}
{{- end -}}
{{- if $servers -}}
# Add the user-scope MCP servers .chezmoidata/claude.toml declares for this
# machine's profiles (Windows counterpart of the .sh sibling). A server already
# configured under the same name is left as is.
#
# Arguments go through `claude mcp add ... -- <command> <args>` rather than
# add-json: Windows PowerShell strips embedded double quotes from native
# command arguments, which corrupts a JSON string.
#
# ASCII-only: chezmoi writes scripts as UTF-8 without BOM, and PowerShell
# defaults to CP1252 parsing on Windows, which mangles multi-byte chars.
#
# Inlining the desired servers below makes run_onchange retrigger when
# claude.toml changes:
{{- range $name, $server := $servers }}
#   {{ $name }} -> {{ $server | mustToJson }}
{{- end }}

$ErrorActionPreference = "Stop"

if (-not (Get-Command claude -ErrorAction SilentlyContinue)) {
    Write-Host 'i  claude CLI not on PATH; skipping MCP server sync'
    exit 0
}

$failed = 0

{{- range $name, $server := $servers }}
& claude mcp get '{{ $name }}' *> $null
if ($LASTEXITCODE -eq 0) {
    Write-Host '[skip] MCP server {{ $name }} already configured' -ForegroundColor DarkGray
} else {
    & claude mcp add -s user '{{ $name }}'
    {{- range $k, $v := get $server "env" | default dict }} -e '{{ printf "%s=%s" $k $v | replace "'" "''" }}'{{ end }} -- '{{ $server.command | replace "'" "''" }}'
    {{- range $server.args }} '{{ . | replace "'" "''" }}'{{ end }} | Out-Null
    if ($LASTEXITCODE -eq 0) {
        Write-Host '[ok]   MCP server {{ $name }} added' -ForegroundColor Green
    } else {
        Write-Host '[fail] MCP server {{ $name }} failed to add' -ForegroundColor Red
        $failed = 1
    }
}
{{- end }}

exit $failed
{{- end -}}
