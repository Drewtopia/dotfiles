{{- if and (eq .chezmoi.os "windows") .dev_computer -}}
#!/usr/bin/env pwsh

# Install PSGallery modules used by Microsoft.PowerShell_profile.ps1.tmpl on
# Windows dev machines. Re-runs when this script's content changes.

# Re-launch with pwsh 7 if running under PowerShell 5.1, which lacks
# PSResourceGet (bundled with PowerShell 7.4+).
# The apply's PATH predates a pwsh installed earlier in the same apply, so fall
# back to the default install location before giving up.
if ($PSVersionTable.PSVersion.Major -lt 7) {
    $pwsh = (Get-Command pwsh -ErrorAction SilentlyContinue).Source
    if (-not $pwsh) {
        $default = Join-Path $env:ProgramFiles 'PowerShell\7\pwsh.exe'
        if (Test-Path $default) { $pwsh = $default }
    }
    if (-not $pwsh) {
        Write-Host "[ERROR] pwsh 7 not found; install Microsoft.PowerShell and re-run chezmoi apply" -ForegroundColor Red
        exit 1
    }
    & $pwsh -NoProfile -NonInteractive -File $MyInvocation.MyCommand.Path
    exit $LASTEXITCODE
}

if (-not (Get-Command Install-PSResource -ErrorAction SilentlyContinue)) {
    Write-Host "[ERROR] Install-PSResource not found; PowerShell 7.4+ ships it" -ForegroundColor Red
    exit 1
}

$modules = @(
    'Terminal-Icons'    # File/folder icons in Get-ChildItem
)

$failed = @()
foreach ($mod in $modules) {
    if (Get-Module -ListAvailable -Name $mod) {
        Write-Host "[OK] $mod already installed" -ForegroundColor Green
        continue
    }
    Write-Host "[Install] $mod" -ForegroundColor Blue
    try {
        # -TrustRepository trusts PSGallery for this install only, so no prompt
        # blocks the non-interactive apply and the repository policy is unchanged.
        Install-PSResource -Name $mod -Repository PSGallery -Scope CurrentUser `
            -TrustRepository -Quiet -ErrorAction Stop
        Write-Host "[OK] $mod installed" -ForegroundColor Green
    } catch {
        Write-Host "[ERROR] Failed to install $mod : $($_.Exception.Message)" -ForegroundColor Red
        $failed += $mod
    }
}

if ($failed.Count -gt 0) {
    exit 1
}
{{- end }}
