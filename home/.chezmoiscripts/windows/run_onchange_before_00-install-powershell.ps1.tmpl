{{- if eq .chezmoi.os "windows" -}}
# Install PowerShell 7+ via winget (runs with built-in powershell.exe 5.1)

$ErrorActionPreference = "Stop"

# Check if pwsh is already available
if (Get-Command pwsh -ErrorAction SilentlyContinue) {
    $version = (pwsh -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()')
    Write-Host "[OK] PowerShell 7 already installed (v$version)" -ForegroundColor Green
    exit 0
}

Write-Host "[Install] Installing PowerShell 7 via winget..." -ForegroundColor Blue

# A failing native command sets $LASTEXITCODE but never throws, so check it.
winget install --id Microsoft.PowerShell --exact --source winget --disable-interactivity `
    --accept-package-agreements --accept-source-agreements
if ($LASTEXITCODE -ne 0) {
    Write-Host "[ERROR] winget install Microsoft.PowerShell exited $LASTEXITCODE" -ForegroundColor Red
    Write-Host "[INFO] Install manually: winget install --id Microsoft.PowerShell --source winget" -ForegroundColor Yellow
    exit 1
}
Write-Host "[OK] PowerShell 7 installed" -ForegroundColor Green
{{- end }}
