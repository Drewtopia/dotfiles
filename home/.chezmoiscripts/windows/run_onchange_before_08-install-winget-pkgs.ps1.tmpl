{{- if and (eq .chezmoi.os "windows") .dev_computer -}}
#!/usr/bin/env pwsh
# Install winget packages declared in home/.chezmoidata/winget.toml.
#
# Slot 08: lands after mise/pwsh bootstrap (00) and env-vars (05), before
# scoop (10). Any winget-managed prereq is on PATH for downstream scripts.
#
# Scope/location strategy:
#   - Not relocated (personal): `mise bootstrap packages apply`, from the
#     winget entries in .chezmoitemplates/mise-bootstrap.toml. mise passes no
#     scope, so winget chooses the manifest's default; Inno/MSI installers
#     prompt UAC (acceptable on personal).
#   - Relocated (work): this script's own loop, which passes --scope user
#     --location to keep portable manifests inside the whitelisted dev path.
#     mise has no option for either. Non-portable manifests reject these
#     flags - list them in winget.toml no_scope (installs bare) or move dev
#     tools to scoop.toml [scoop.work].

$ErrorActionPreference = 'Stop'

# Probe launch, not file presence - MSIX alias exists but session 0 can't activate it.
$wingetOk = $false
try { & winget --version *>$null; $wingetOk = ($LASTEXITCODE -eq 0) } catch {}
if (-not $wingetOk) {
    Write-Host '[winget] CLI not usable in this session; skipping' -ForegroundColor Yellow
    exit 0
}

{{- if not .relocated }}

# This script runs before chezmoi writes ~/.config/mise/conf.d/bootstrap.toml,
# so it applies an inline copy; the copy also retriggers run_onchange when the
# list changes. It goes in as a trusted project mise.toml in a temp dir:
# pointing MISE_GLOBAL_CONFIG_FILE at it instead demotes the real global
# config to an untrusted project file, and mise refuses to run.
$tmpDir = Join-Path ([IO.Path]::GetTempPath()) ("mise-bootstrap-" + [guid]::NewGuid())
New-Item -ItemType Directory -Path $tmpDir | Out-Null
# chezmoi runs this under Windows PowerShell 5.1, which has no utf8NoBOM
# encoding; write UTF-8 without a BOM through .NET instead.
$bootstrapToml = @'
{{ template "mise-bootstrap.toml" . }}
'@
[IO.File]::WriteAllText((Join-Path $tmpDir 'mise.toml'), $bootstrapToml, (New-Object Text.UTF8Encoding $false))

# chezmoi.toml puts 00-install-mise's location on PATH; fall back to it directly.
$mise = (Get-Command mise -ErrorAction SilentlyContinue).Source
if (-not $mise) { $mise = '{{ .directories.tools_root }}\tools\mise\bin\mise.exe' -replace '/', '\' }
# A WinGet Links entry is a symlink, which a non-interactive (SSH) session can't launch.
$target = (Get-Item $mise -ErrorAction SilentlyContinue).Target
if ($target) { $mise = @($target)[0] }

Push-Location $tmpDir
try {
    # Capture stdout instead of *>$null, which fails in pwsh sessions without a
    # console. Leave stderr alone: under 5.1 with ErrorActionPreference Stop,
    # 2>&1 turns any mise WARN line into a terminating NativeCommandError.
    $null = & $mise bootstrap packages --help
    if ($LASTEXITCODE -ne 0) {
        throw "$mise has no 'bootstrap packages' (needs mise 2026.9.3+ for winget); run: winget upgrade jdx.mise"
    }
    $env:MISE_TRUSTED_CONFIG_PATHS = $tmpDir
    & $mise bootstrap packages apply --yes
    if ($LASTEXITCODE -ne 0) { throw "mise bootstrap packages apply exit $LASTEXITCODE" }
} finally {
    Pop-Location
    Remove-Item Env:MISE_TRUSTED_CONFIG_PATHS -ErrorAction SilentlyContinue
    Remove-Item -Recurse -Force $tmpDir -ErrorAction SilentlyContinue
}

Write-Host '[OK] winget package install completed' -ForegroundColor Green
{{- else }}

# Idempotent: `winget list --id <id> --exact` returns exit 0 only when the
# package is installed; non-zero means "not found" and we trigger install.
$wingetPackages = @(
{{- range .winget.packages }}
    '{{ . }}'
{{- end }}
{{- if .personal }}
{{- range .winget.personal.packages }}
    '{{ . }}'
{{- end }}
{{- end }}
{{- if .work }}
{{- range .winget.work.packages }}
    '{{ . }}'
{{- end }}
{{- end }}
)

if ($wingetPackages.Count -eq 0) {
    Write-Host '[winget] No packages declared; nothing to do' -ForegroundColor DarkGray
    exit 0
}

# IDs whose manifest has no user-scoped installer; installed with bare flags
# even on relocated machines (see winget.toml [winget] no_scope).
$noScope = @(
{{- range .winget.no_scope }}
    '{{ . }}'
{{- end }}
)

$workLocation = '{{ .directories.tools_root }}\tools' -replace '/', '\'
if (-not (Test-Path $workLocation)) {
    New-Item -ItemType Directory -Force -Path $workLocation | Out-Null
}

$failed = @()
foreach ($id in $wingetPackages) {
    # --source winget skips the msstore source, whose query hangs on
    # restricted networks; --disable-interactivity guarantees no prompt
    # can block a non-interactive `chezmoi apply`.
    & winget list --id $id --exact --source winget `
        --accept-source-agreements --disable-interactivity 2>$null | Out-Null
    if ($LASTEXITCODE -eq 0) {
        Write-Host "[OK] $id already installed" -ForegroundColor Green
        continue
    }

    Write-Host "[Install] winget install $id" -ForegroundColor Blue
    # Scope-less installers (see $noScope) reject --scope user --location and
    # winget reports "No applicable installer found"; install them bare.
    if ($noScope -contains $id) {
        & winget install --id $id --exact --source winget --disable-interactivity `
            --accept-package-agreements --accept-source-agreements
    } else {
        & winget install --id $id --exact --source winget --disable-interactivity `
            --accept-package-agreements --accept-source-agreements `
            --scope user --location $workLocation
    }
    if ($LASTEXITCODE -ne 0) {
        $failed += $id
        Write-Host "[ERROR] winget install $id exit $LASTEXITCODE" -ForegroundColor Red
    }
}

if ($failed.Count -gt 0) {
    Write-Host "[ERROR] winget install failures: $($failed -join ', ')" -ForegroundColor Red
    exit 1
}

Write-Host '[OK] winget package install completed' -ForegroundColor Green
{{- end }}
{{- end -}}
