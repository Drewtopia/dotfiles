{{- if includeTemplate "linux-supported" . -}}
{{- /* CLI + shell tools moved to mise: bat, fd, rg, gh, jq, age, fzf, zoxide, atuin, carapace, neovim */ -}}
{{- /* core: the apply is broken without these, so a failure stops it */ -}}
{{- $core := list
     "ca-certificates"
     "curl"
     "git"
     "gnupg"
     "tmux"
     "unzip"
     "xz-utils"
     "zsh" -}}
{{- /* optional: installed one at a time so a missing package only warns */ -}}
{{- $optional := list
     "btop"
     "git-lfs"
     "pkg-config"
     "shellcheck"
     "units"
     "wget" -}}
{{- $snaps := list -}}
{{- $classicSnaps := list -}}
{{- if .dev_computer -}}
{{-   $optional = mustAppend $optional "ffmpeg" -}}
{{- end -}}
{{- if not .ephemeral -}}
{{-   $optional = mustAppend $optional "xclip" -}}
{{-   if not .is_wsl -}}
{{-   $classicSnaps = mustAppend $classicSnaps "code" -}}
{{-   end -}}
{{- end -}}
{{- $sudo := "sudo " -}}
{{- if eq .chezmoi.username "root" -}}
{{-   $sudo = "" -}}
{{- end -}}
{{- $apt := printf "%senv DEBIAN_FRONTEND=noninteractive apt-get" $sudo -}}
#!/bin/bash

set -eufo pipefail

echo "🐧 Installing system packages on Linux..."

{{ $apt }} update
{{ $apt }} install -y {{ $core | join " " }}

failed=()
for pkg in {{ $optional | join " " }}; do
    {{ $apt }} install -y "$pkg" || failed+=("$pkg")
done

{{ if and (lookPath "snap") (or $snaps $classicSnaps) }}
if [[ -S /run/snapd.socket ]]; then
{{   range $snaps }}
( snap info {{ . }} | grep -q ^installed: ) || {{ $sudo }}snap install {{ . }} || true
{{   end }}
{{   range $classicSnaps }}
( snap info {{ . }} | grep -q ^installed: ) || {{ $sudo }}snap install --classic {{ . }} || true
{{   end }}
fi
{{ end }}

if (( ${#failed[@]} )); then
    echo "⚠️  Optional apt packages not installed: ${failed[*]}" >&2
    echo "✅ Core apt packages installed"
else
    echo "✅ apt packages installed!"
fi
{{ else if eq .chezmoi.os "linux" -}}
#!/bin/bash
echo "⚠️  Unsupported Linux ({{ .osid }} {{ get .chezmoi.osRelease "versionID" }}): supported are Debian 12+, Ubuntu 22.04+ and Raspberry Pi OS 12+." >&2
echo "⚠️  Skipping apt packages, mise, 1Password and login-shell setup; dotfiles still apply." >&2
{{ end -}}
