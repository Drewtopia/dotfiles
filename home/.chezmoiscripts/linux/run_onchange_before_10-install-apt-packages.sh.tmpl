{{- if includeTemplate "linux-supported" . -}}
#!/bin/bash

set -eufo pipefail

echo "🐧 Installing system packages on Linux..."

# Packages are declared in .chezmoitemplates/mise-bootstrap.toml. This script
# runs before chezmoi writes ~/.config/mise/conf.d/bootstrap.toml, so it applies
# an inline copy; the copy also retriggers run_onchange when the list changes.
# mise runs apt-get through sudo itself when not root (--update runs apt-get
# update first), so this needs passwordless sudo or a terminal.
# mise picks the parser from the extension, so the file must end in .toml.
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
config="$tmpdir/bootstrap.toml"
cat > "$config" <<'EOF'
{{ template "mise-bootstrap.toml" . }}
EOF
# before_00 installs mise to ~/.local/bin, which a fresh shell may not have on PATH.
mise_bin="$(command -v mise || echo "$HOME/.local/bin/mise")"
if ! "$mise_bin" bootstrap packages --help >/dev/null 2>&1; then
    echo "❌ $mise_bin has no 'bootstrap packages' (needs mise 2026.7.4+); run: $mise_bin self-update" >&2
    exit 1
fi
MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" bootstrap packages apply --yes --update

echo "✅ System packages installed!"
{{ else if eq .chezmoi.os "linux" -}}
#!/bin/bash
echo "⚠️  Unsupported Linux ({{ .osid }} {{ get .chezmoi.osRelease "versionID" }}): supported are Debian 12+, Ubuntu 22.04+ and Raspberry Pi OS 12+." >&2
echo "⚠️  Skipping apt packages, mise, 1Password and login-shell setup; dotfiles still apply." >&2
{{ end -}}
