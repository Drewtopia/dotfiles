{{- if eq .osid "linux-ubuntu" }}

[".local/bin/cue"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "cue-lang/cue" (printf "cue_v*_%s_%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
    executable = true
    path = "cue"

{{- end }}

{{- if not .ephemeral }}
{{- /* Windows fonts here still need HKCU registration: see
       run_onchange_after_40-register-windows-fonts.ps1.tmpl. */ -}}
{{-   $fontDir := "" }}
{{-   if eq .chezmoi.os "darwin" }}
{{-     $fontDir = "Library/Fonts" }}
{{-   else if eq .chezmoi.os "linux" }}
{{-     $fontDir = ".local/share/fonts" }}
{{-   else if eq .chezmoi.os "windows" }}
{{-     $fontDir = "AppData/Local/Microsoft/Windows/Fonts" }}
{{-   end }}

{{- /* Windows gets Meslo from scoop (Meslo-NF). */ -}}
{{-   if and (ne $fontDir "") (ne .chezmoi.os "windows") }}
{{-   range (list
        "MesloLGS NF Regular.ttf"
        "MesloLGS NF Bold.ttf"
        "MesloLGS NF Italic.ttf"
        "MesloLGS NF Bold Italic.ttf") }}
["{{ $fontDir }}/{{ . }}"]
    type = "file"
    url = "https://github.com/romkatv/powerlevel10k-media/raw/master/{{ . }}"
    refreshPeriod = "168h"
{{-   end }}
{{-   end }}

{{- /* macOS gets CaskaydiaCove from a cask, Windows from scoop. */ -}}
{{-   if eq .chezmoi.os "linux" }}

[".local/share/fonts/CaskaydiaCove"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/CascadiaCode.zip"
    exact = true
    refreshPeriod = "672h"
    include = ["*.ttf", "*.otf"]
{{-   end }}

{{- /* macOS gets Maple Mono from font-maple-mono* casks. */ -}}
{{-   if and (ne $fontDir "") (ne .chezmoi.os "darwin") }}

["{{ $fontDir }}/MapleMono"]
    type = "archive"
    url = {{ gitHubLatestReleaseAssetURL "subframe7536/maple-font" "MapleMono-TTF.zip" | quote }}
    exact = true
    refreshPeriod = "672h"
    include = ["*.ttf"]

["{{ $fontDir }}/MapleMono-NF"]
    type = "archive"
    url = {{ gitHubLatestReleaseAssetURL "subframe7536/maple-font" "MapleMono-NF.zip" | quote }}
    exact = true
    refreshPeriod = "672h"
    include = ["*.ttf"]

["{{ $fontDir }}/MapleMonoNL-NF"]
    type = "archive"
    url = {{ gitHubLatestReleaseAssetURL "subframe7536/maple-font" "MapleMonoNL-NF.zip" | quote }}
    exact = true
    refreshPeriod = "672h"
    include = ["*.ttf"]
{{-   end }}
{{- end }}


[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
    exclude = [
        "*/.*",
        "*/templates",
        "*/themes",
    ]

[".oh-my-zsh/custom/plugins/zsh-active-cheatsheet"]
    type = "archive"
    url = "https://github.com/norsemangrey/zsh-active-cheatsheet/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
    exclude = [
        "*/.editorconfig",
        "*/.gitattributes",
        "*/.github",
        "*/.gitignore",
        "*/README.md",
    ]

[".oh-my-zsh/custom/themes/powerlevel10k"]
    type = "archive"
    url = "https://github.com/romkatv/powerlevel10k/archive/{{ (gitHubLatestRelease "romkatv/powerlevel10k").TagName }}.tar.gz"
    exact = true
    stripComponents = 1

# git-repo, not archive: tpm treats a plugin dir without a git remote as not
# installed and fails re-cloning it into the existing directory.
[".config/tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"

[".config/tmux/plugins/tmux-sensible"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tmux-sensible.git"
    refreshPeriod = "168h"

[".local/share/zinit/zinit.git"]
    type = "git-repo"
    url = "https://github.com/zdharma-continuum/zinit.git"
    refreshPeriod = "168h"

{{- if or .personal (and .work (ne .chezmoi.os "windows")) }}
# Cloned wherever Claude Code runs; ~/.claude/{memory,rules} symlink here.
# --ff-only: diverged local commits surface as fetch failures, never a merge.
[".claude-vault"]
    type = "git-repo"
    url = "git@github.com:Drewtopia/claude-vault.git"
    refreshPeriod = "168h"
    [".claude-vault".clone]
        args = ["--depth=1"]
    [".claude-vault".pull]
        args = ["--ff-only"]
{{- end }}

[".config/eza/theme.yml"]
    type = "file"
    url = "https://raw.githubusercontent.com/eza-community/eza-themes/main/themes/catppuccin-mocha.yml"
    refreshPeriod = "168h"

[".config/yazi/theme.toml"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/yazi/main/themes/mocha/catppuccin-mocha-blue.toml"
    refreshPeriod = "168h"

[".config/btop/themes/catppuccin_mocha.theme"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/btop/main/themes/catppuccin_mocha.theme"
    refreshPeriod = "168h"
